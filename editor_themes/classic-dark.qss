/* Godot Editor 风格深色主题（经典）— 全局共享主题 (所有编辑器统一使用) */
/* 色板: 底色 #202531 / 边框 #14171f / 强调 #478cbf */

QWidget {background-color: #202531; color: #dcdcdc; font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; font-size: 13px;}
QMainWindow, QDialog {background-color: #1d212d;}
QMainWindow#EditorWindow {background-color: #1d212d;}
QToolTip {background-color: #292f3c; color: #e0e4eb; border: 1px solid #3b445c; border-radius: 6px; padding: 6px 8px;}

/* ── 表格、树与通用项目视图 ── */
QAbstractItemView {background-color: #292f3c; color: #e0e4eb; selection-background-color: rgba(71, 140, 191, 0.24); selection-color: #e0e4eb; outline: none;}
QTableWidget, QTreeWidget, QTableView, QTreeView {background-color: #1a1e27; color: #dcdcdc; border: 1px solid #14171f; border-radius: 8px; gridline-color: #323a4f; selection-background-color: #478cbf; selection-color: #ffffff; alternate-background-color: #242934; outline: none;}
QTableWidget::item, QTreeWidget::item,
QTableView::item, QTreeView::item {min-height: 28px; padding: 6px 10px; border: none;}
QTableWidget::item:selected, QTreeWidget::item:selected,
QTableView::item:selected, QTreeView::item:selected {background-color: rgba(71, 140, 191, 0.24); color: #e0e4eb;}
QWidget#WarDataEditorRightPanel QTableWidget,
QWidget#WarDataEditorRightPanel QTableView {selection-background-color: transparent; selection-color: #e0e4eb;}
QWidget#WarDataEditorRightPanel QTableWidget::item:selected,
QWidget#WarDataEditorRightPanel QTableView::item:selected {background-color: transparent; color: #e0e4eb;}
QListWidget::item:hover, QTreeWidget::item:hover {background-color: #323a4f;}
QHeaderView {background-color: #1d212d;}
QHeaderView::section {background-color: #202531; color: #aab4cd; border: none; border-bottom: 1px solid #14171f; padding: 7px 8px;}
QHeaderView::section:hover {background-color: #292f3c; color: #e0e4eb;}
QHeaderView::section:pressed {background-color: rgba(71, 140, 191, 0.22); color: #e0e4eb;}
QTableCornerButton::section {background-color: #1d212d; border: none; border-bottom: 1px solid #3b445c;}

/* ── 文本输入 ── */
QPlainTextEdit, QLineEdit, QTextEdit {background-color: #1a1e27; color: #e0e4eb; border: 1px solid #14171f; padding: 7px 9px; border-radius: 8px; selection-background-color: #478cbf; selection-color: #ffffff;}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {border-color: #505a74;}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {border-color: #478cbf;}
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {background-color: #212632; color: #6c7793; border-color: #2d3344;}

/* ── 按钮与工具按钮 ── */
QPushButton {background-color: #2e3548; color: #dcdcdc; border: 1px solid #14171f; border-radius: 8px; padding: 6px 12px; min-height: 18px;}
QPushButton:hover {background-color: #3b445c; border-color: #505a74;}
QPushButton:focus {border-color: #478cbf;}
QPushButton:pressed {background-color: #478cbf; border-color: #478cbf;}
QPushButton:checked {background-color: rgba(71, 140, 191, 0.22); color: #e0e4eb; border-color: #478cbf;}
QPushButton:disabled {background-color: #252a35; color: #555; border-color: #2d3344;}
QPushButton:flat {background-color: transparent; border-color: transparent;}
QPushButton:flat:hover {background-color: #292f3c; border-color: transparent;}
QPushButton:flat:pressed {background-color: rgba(71, 140, 191, 0.22);}
QToolButton {background-color: transparent; color: #aab4cd; border: 1px solid transparent; border-radius: 8px; padding: 5px 8px;}
QToolButton:hover {background-color: #292f3c; color: #e0e4eb; border-color: #3b445c;}
QToolButton:pressed, QToolButton:checked {background-color: rgba(71, 140, 191, 0.22); color: #e0e4eb; border-color: #478cbf;}

/* ── 下拉框与数值输入 ── */
QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {background-color: #292f3c; color: #e0e4eb; border: 1px solid #3b445c; border-radius: 8px; padding: 6px 9px; min-height: 18px;}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {border-color: #505a74;}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {border-color: #478cbf;}
QComboBox::drop-down {subcontrol-origin: padding; subcontrol-position: top right; width: 28px; border-top-right-radius: 7px; border-bottom-right-radius: 7px;}
QComboBox:hover::drop-down, QComboBox:focus::drop-down {background-color: rgba(255, 255, 255, 0.04);}
QComboBox::down-arrow {image: url(svg/down-arrow.svg); width: 12px; height: 12px;}
QComboBox QAbstractItemView {background-color: #202531; color: #dcdcdc; border: 1px solid #14171f; selection-background-color: #478cbf; selection-color: #ffffff; outline: none; padding: 4px; border-radius: 8px; show-decoration-selected: 1;}
QComboBox QAbstractItemView::item {min-height: 24px; padding: 6px 10px; border-radius: 6px;}
QComboBox QAbstractItemView::item:hover {background-color: #323a4f; color: #e0e4eb;}
QComboBox QAbstractItemView::item:selected {background-color: #478cbf; color: #ffffff;}
QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {padding-right: 24px;}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {subcontrol-origin: border; subcontrol-position: top right; background-color: #2d3446; width: 20px; border-left: 1px solid #3b445c; border-bottom: 1px solid #3b445c; border-top-right-radius: 7px;}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow, QTimeEdit::up-arrow, QDateTimeEdit::up-arrow {image: url(svg/up-arrow.svg); width: 10px; height: 10px;}
QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {subcontrol-origin: border; subcontrol-position: bottom right; background-color: #2d3446; width: 20px; border-left: 1px solid #3b445c; border-top: 1px solid #3b445c; border-bottom-right-radius: 7px;}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {image: url(svg/down-arrow.svg); width: 10px; height: 10px;}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {background-color: #39425a;}

/* ── 列表与选择器 ── */
QListWidget {background-color: #1a1e27; color: #e0e4eb; border: 1px solid #14171f; border-radius: 8px; outline: none;}
QListWidget::item, QTreeWidget::item {border: none; border-radius: 6px; padding: 5px 8px;}
QListWidget::item:selected, QTreeWidget::item:selected {background-color: rgba(71, 140, 191, 0.24); color: #e0e4eb;}
QListWidget::item:focus, QTreeWidget::item:focus {outline: none;}
QListWidget::indicator, QTableWidget::indicator {width: 16px; height: 16px; background-color: #1a1e27; border: 1px solid #14171f; border-radius: 5px;}
QListWidget::indicator:checked, QTableWidget::indicator:checked {background-color: #478cbf; border-color: #478cbf; image: url(svg/checkmark.svg);}
QListWidget::indicator:hover, QTableWidget::indicator:hover {border-color: #3b445c;}

/* ── 分组框、复选框与单选按钮 ── */
QGroupBox {background-color: #202531; border: 1px solid #14171f; border-radius: 10px; margin-top: 16px; padding: 14px 10px 10px 10px;}
QGroupBox::title {subcontrol-origin: margin; subcontrol-position: top left; padding: 0 6px; color: #a5b0cb;}
QCheckBox, QRadioButton {color: #e0e4eb; spacing: 7px; padding: 3px 0;}
QCheckBox::indicator, QRadioButton::indicator {width: 16px; height: 16px; background-color: #292f3c; border: 1px solid #505a74;}
QCheckBox::indicator {border-radius: 5px;}
QRadioButton::indicator {border-radius: 8px;}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {background-color: #478cbf; border-color: #478cbf; image: url(svg/checkmark.svg);}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {border-color: #478cbf;}
QCheckBox:disabled, QRadioButton:disabled {color: #6c7793;}

/* ── 分割线与滚动条 ── */
QSplitter::handle {image: none; background-color: transparent;}
QSplitter {background-color: transparent;}
QSplitter::handle:horizontal {border-left: 1px solid #14171f; margin-left: 3px; margin-right: 3px;}
QSplitter::handle:vertical {border-top: 1px solid #14171f; margin-top: 3px; margin-bottom: 3px;}
QSplitter::handle:horizontal:hover, QSplitter::handle:vertical:hover {border-color: #478cbf;}
QScrollBar:vertical {background: #1a1e27; width: 10px; margin: 2px;}
QScrollBar::handle:vertical {background: #3b445c; border-radius: 4px; min-height: 28px; margin: 2px 1px;}
QScrollBar::handle:vertical:hover {background: #478cbf;}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {height: 0;}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {background: transparent;}
QScrollBar:horizontal {background: #1a1e27; height: 10px; margin: 2px;}
QScrollBar::handle:horizontal {background: #3b445c; border-radius: 4px; min-width: 28px; margin: 1px 2px;}
QScrollBar::handle:horizontal:hover {background: #478cbf;}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {width: 0;}

/* ── 菜单栏与菜单 ── */
QMenuBar {background-color: #202531; color: #dcdcdc; border-bottom: 1px solid #14171f;}
QMenuBar::item {background: transparent; padding: 6px 10px; border-radius: 6px;}
QMenuBar::item:selected {background-color: #3b445c; color: #e0e4eb;}
QMenuBar::item:pressed {background-color: #478cbf; color: #ffffff;}
QMenu {background-color: #202531; color: #e0e4eb; border: 1px solid #14171f; border-radius: 8px; padding: 5px;}
QMenu::item {padding: 7px 28px 7px 10px; border-radius: 6px;}
QMenu::item:selected {background-color: #478cbf; color: #ffffff;}
QMenu::icon {padding-left: 4px;}
QMenu::separator {height: 1px; background-color: #14171f; margin: 5px 7px;}

/* 所有编辑器下拉菜单共用原生 QMenu，保持单层圆角边框。 */
QMenu#EditorComboMenu {background-color: #292f3c; color: #e0e4eb; border: 1px solid #3b445c; border-radius: 8px; padding: 4px;}
QMenu#EditorComboMenu::item {padding: 6px 28px 6px 10px; border-radius: 5px;}
QMenu#EditorComboMenu::item:selected {background-color: #323a4f; color: #e0e4eb;}
QMenu#EditorComboMenu::item:checked {background-color: #478cbf; color: #ffffff; font-weight: 600;}

/* ── 下拉框可滚动弹层 (条目 >10 时替代 QMenu) ── */
QWidget#EditorComboPopup {background-color: #292f3c; border: 1px solid #3b445c; border-radius: 8px;}
/* padding:0 抵消 QComboBox QAbstractItemView{padding:4px} 泄漏, 否则视口矮 8px 显示不足行 */
QListWidget#EditorComboList {background-color: transparent; border: none; color: #e0e4eb; outline: none; padding: 0;}
QListWidget#EditorComboList::item {padding: 6px 10px; border-radius: 5px;}
QListWidget#EditorComboList::item:hover {background-color: #323a4f; color: #e0e4eb;}
QListWidget#EditorComboList::item:selected {background-color: #478cbf; color: #ffffff; font-weight: 600;}
QListWidget#EditorComboList::item:disabled {color: #5c6680;}

/* ── Tab 页 ── */
QTabWidget::pane {border: 1px solid #14171f; background-color: #202531; top: -1px; border-radius: 10px; padding: 4px;}
QTabBar::tab {background: #202531; color: #95a0bd; border: 1px solid #14171f; padding: 7px 13px; margin: 2px 2px 0 0; border-radius: 8px; min-height: 18px;}
QTabBar::tab:selected {background: #1a1e27; color: #478cbf; border: 1px solid #3b445c; border-bottom: 2px solid #478cbf;}
QTabBar::tab:hover:!selected {background: #3b445c; color: #e0e4eb; border-color: #323a4f;}
QTabBar::tab:disabled {color: #5c6680;}
QTabBar QToolButton {background-color: #292f3c; border: 1px solid #3b445c; border-radius: 6px; padding: 2px;}

/* ── 连续内容面板页签: 平面导航 + 统一 TabPane ── */
QTabWidget[tabStyle="flat"] {background-color: transparent; border: none;}
QTabWidget[tabStyle="flat"]::pane {border: 1px solid #3b445c; border-top: none; border-radius: 0px 0px 8px 8px; background-color: #1d212d; padding: 0px; top: 0px;}
QTabWidget[tabStyle="flat"] QTabBar {background-color: #1d212d; border: none; border-bottom: 1px solid #3b445c;}
QTabWidget[tabStyle="flat"] QTabBar::tab {background-color: transparent; color: #95a0bd; border: none; border-bottom: 1px solid #3b445c; border-radius: 0px; padding: 8px 13px; margin: 0px; min-height: 20px;}
QTabWidget[tabStyle="flat"] QTabBar::tab:hover:!selected {background-color: #252a35; color: #e0e4eb; border-top-left-radius: 8px; border-top-right-radius: 8px;}
QTabWidget[tabStyle="flat"] QTabBar::tab:selected {background-color: #1d212d; color: #e0e4eb; font-weight: 600; border: 1px solid #3b445c; border-top: 2px solid #478cbf; border-bottom: 1px solid #1d212d; border-top-left-radius: 8px; border-top-right-radius: 8px; margin-bottom: -1px;}
QTabWidget[tabStyle="flat"] QTabBar::tab:disabled {color: #5c6680;}
QWidget#EditorTabCorner {background-color: #1d212d; border: none; border-bottom: 1px solid #3b445c;}

/* ── 编辑器面板、图形视图与滚动区域 ── */
QWidget#DockPanel {background-color: transparent; border: none;}
QFrame#DockHeader {background-color: #14171f; border: 1px solid #3b445c; border-bottom: none; border-top-left-radius: 10px; border-top-right-radius: 10px;}
QWidget#DockBody {background-color: #202531; border: 1px solid #14171f; border-top: none; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;}
QWidget#PalettePanel {background-color: #212632; border: 1px solid #3b445c; border-radius: 10px;}
QLabel#DockTitle {background-color: transparent; color: #a5b0cb; font-weight: bold;}
QGraphicsView {border: 1px solid #14171f; border-radius: 8px; background-color: #1a1e27;}
QScrollArea {background-color: #202531; border: none; border-radius: 8px;}

/* 主编辑区滚动页不再叠加自己的矩形边框，边框只由 tab 外壳负责。 */
QTabWidget[tabStyle="flat"] QScrollArea {background-color: transparent; border: none; border-radius: 0px;}

/* 左侧角色表由外框负责圆角，表头保持透明以免覆盖四角。 */
QTableWidget#WarpcCharacterTable {border-radius: 8px;}
QTableWidget#WarpcCharacterTable QHeaderView {background-color: transparent; border-top-left-radius: 7px; border-top-right-radius: 7px;}
QTableWidget#WarpcCharacterTable QHeaderView::section,
QTableWidget#WarpcCharacterTable QTableCornerButton::section {background-color: transparent;}
QSlider::groove:horizontal {background-color: #1a1e27; border: 1px solid #14171f; height: 6px; border-radius: 3px;}
QSlider::handle:horizontal {background-color: #3b445c; width: 14px; margin: -4px 0; border-radius: 7px;}
QSlider::handle:horizontal:hover {background-color: #478cbf;}
QProgressBar {background-color: #292f3c; border: 1px solid #3b445c; border-radius: 6px; text-align: center; color: #e0e4eb;}
QProgressBar::chunk {background-color: #478cbf; border-radius: 5px;}

/* ── 状态栏与标签 ── */
QStatusBar {background-color: #202531; color: #888; border-top: 1px solid #14171f; padding: 2px 8px;}
QStatusBar::item {border: none;}
QLabel {color: #dcdcdc; background-color: transparent;}
QLabel#StatusLabel {color: #a5b0cb; font-size: 12px; padding: 0 4px;}
QLabel#StatusSep {color: #3b445c; font-size: 12px; padding: 0 2px;}
QLabel#StatusInfo {color: #8a96b3; font-size: 12px; padding: 0 4px;}
QLabel#StatusPixel {color: #6a7590; font-size: 11px; padding: 0 4px; font-family: 'Consolas', 'Courier New', monospace;}
QLabel#hintLabel {color: #888888; font-size: 11px;}
/* ── Inspector 标题 (kon/wardata/warpc) ── */
QLabel[class="InspectorTitle"] {font-weight: bold; color: #a5b0cb; border-bottom: 1px solid #14171f; padding-bottom: 2px; margin-top: 8px;}
QLabel[class="PropLabel"] {color: #8a96b3;}

/* ── 预览区面板 (kon/wardata/warpc) ── */
QFrame#PreviewFrame {background-color: transparent; border: none; border-top: 2px solid #2b4f70; border-radius: 10px; margin-top: 4px; margin-bottom: 8px;}
QLabel[class="PreviewName"] {color: #e0e4eb; font-size: 18px; font-weight: bold; font-family: 'Microsoft YaHei', 'Segoe UI';}
QLabel[class="PreviewMeta"] {color: #8a96b3; font-size: 11px; border-bottom: 1px solid #2e3548; padding-bottom: 8px; margin-bottom: 4px;}
QLabel[class="PreviewDesc"] {color: #55b572; font-size: 13px; padding-top: 4px;}
QLabel[class="PreviewSubMeta"] {color: #e27d60; font-size: 12px; font-weight: bold; padding-top: 4px;}

/* ── FakeInputBox 内凹输入框 (kon/wardata/warpc) ── */
QFrame#FakeInputBox {background-color: #161923; border: 1px solid #0b0c12; border-radius: 8px;}
QFrame#FakeInputBox:hover, QFrame#FakeInputBox:focus-within {background-color: #1a1e29; border: 1px solid #478cbf;}
QFrame#FakeInputBox > QLineEdit {background: transparent; border: none; padding: 4px 8px; color: #e0e4eb; font-family: 'Consolas', 'Segoe UI'; selection-background-color: #478cbf;}
QFrame#FakeInputBox > QPushButton {background: transparent; border: none; border-left: 1px solid #202531; border-right: 1px solid #202531; border-radius: 0px; padding: 4px 8px; margin: 0px; color: #8a96b3;}
QFrame#FakeInputBox > QPushButton:hover {background-color: #2e3548; color: #ffffff;}
QFrame#FakeInputBox > QPushButton:first:hover {border-top-left-radius: 7px; border-bottom-left-radius: 7px;}
QFrame#FakeInputBox > QPushButton#FakeInputRightButton {border-right: none; border-top-right-radius: 7px; border-bottom-right-radius: 7px;}
QFrame#FakeInputBox > QPushButton#FakeInputRightButton:hover {border-right: none; border-top-right-radius: 7px; border-bottom-right-radius: 7px;}
QFrame#FakeInputBox > QPushButton#StatusPickerButton {border: none; border-radius: 7px;}
QFrame#FakeInputBox > QPushButton#StatusPickerButton:hover {background-color: #2d3446; color: #ffffff;}
QFrame#FakeInputBox > QComboBox {border: none; background: transparent; padding: 4px 8px; color: #e0e4eb;}
QFrame#FakeInputBox > QComboBox::drop-down {border: none;}
QFrame[class="FakeInputSep"] {background-color: #202531; border: none;}

/* ── 额外预览文本 ── */
QLabel[class="ExtraPreviewText"] {padding: 4px 8px; color: #55b572; font-size: 11px;}

/* ── 拆分字段内部标签 ── */
QLabel[class="SplitFieldLabel"] {color: #8a96b3; font-size: 11px; padding: 0 2px;}

/* ── 状态掩码标签颜色 (kon) ── */
QLabel[class="StatusInflict"] {color: #CC3333; font-size: 11px;}
QLabel[class="StatusRemove"] {color: #3366cc; font-size: 11px;}

/* ── 弹窗高亮主按钮 ── */
QPushButton#PrimaryButton {background-color: #478cbf; color: #ffffff; border: 1px solid #366a91; font-weight: bold;}
QPushButton#PrimaryButton:hover {background-color: #5aa1d5;}
QPushButton#PrimaryButton:pressed {background-color: #366a91;}

/* ── 工具栏 (tks_launcher_gui) ── */
QToolBar {background-color: #1a1e27; border-bottom: 1px solid #14171f; padding: 4px 2px; spacing: 6px;}
QToolBar::separator {width: 1px; background-color: #3b445c; margin: 5px 4px;}

/* ── 控制台日志文本区 (tks_launcher_gui) ── */
/* 注意: 文字颜色由 log_console.py 通过 HTML 内联样式控制, 此处不设置 color */
QTextEdit#LogConsole {background-color: #171A21; border: 1px solid #14171f; border-radius: 4px; padding: 8px; font-family: "Consolas", "Courier New", monospace; font-size: 12px; selection-background-color: #478cbf; selection-color: #ffffff;}

/* ── QCheckBox 禁用状态 ── */
QCheckBox::indicator:disabled {background-color: #252a35; border-color: #1a1e27;}
QCheckBox::indicator:checked:disabled {background-color: #2D4A5E; border-color: #2D4A5E; image: url(svg/checkmark.svg);}
/* 必选补丁复选框：禁用态文字保持正常颜色 */
QCheckBox#requiredPatch:disabled {color: #dcdcdc;}

/* ── 滚动条悬停 (tks_launcher_gui) ── */
QScrollBar::handle:vertical:hover {background-color: #478cbf;}
QScrollBar::handle:horizontal:hover {background-color: #478cbf;}

/* ── 状态栏标签 (tks_launcher_gui) ── */
QLabel#statusLabel {color: #dcdcdc; font-weight: bold; padding: 4px 8px;}
QLabel#statusLabelOk {color: #55b572; font-weight: bold; padding: 4px 8px;}
QLabel#statusLabelError {color: #e27d60; font-weight: bold; padding: 4px 8px;}

/* ── DockHeader 内紧凑工具按钮 (tks_launcher_gui) ── */
QToolButton#dockToolButton {background-color: transparent; color: #a5b0cb; border: none; border-radius: 3px; padding: 0px 6px; max-height: 16px;}
QToolButton#dockToolButton:hover {background-color: #2e3548; color: #dcdcdc;}
QToolButton#dockToolButton:pressed {background-color: #478cbf; color: #fff;}
QToolButton#dockToolButton:checked {background-color: #478cbf; color: #ffffff;}
QToolButton#dockToolButton:checked:hover {background-color: #5a9ccc; color: #ffffff;}

/* ── 启动按钮高亮 (tks_launcher_gui) ── */
QPushButton#btnStart {background-color: #2b5f3a; color: #e0f5e5; border: 1px solid #1e4a2c; font-weight: bold;}
QPushButton#btnStart:hover {background-color: #367a4a;}
QPushButton#btnStart:pressed {background-color: #1e4a2c; color: #ffffff;}
QPushButton#btnStart:disabled {
    background-color: #31463a;
    color: #75887c;
    border-color: #3e5a4a;
}

/* ── 记录标题标签 (item/skill/mat/warpc 编辑器) ── */
QLabel[class="RecordHeader"] {font-size: 14px; font-weight: bold; color: #e0e4eb; background-color: #292f3c; border: 1px solid #3b445c; border-radius: 8px; padding: 5px 10px;}

/* ── 状态提示标签 (mat_editor) ── */
QLabel[class="StatusHint"] {color: #888; font-size: 11px;}

/* ── 紧凑按钮 (mat_editor 工具栏) ── */
QPushButton[class="CompactBtn"] {min-height: 16px; padding: 4px 8px; border-radius: 7px;}

/* ── 打包/操作主按钮 (launcher dialogs) ── */
QPushButton#btnPack {font-weight: bold; padding: 6px 20px;}

/* ── 图标选择器按钮 (item/warpc 编辑器) ── */
QPushButton[selected="true"] {background-color: #2e3548; border: 2px solid #478cbf;}
QPushButton[selected="false"] {background-color: transparent; border: 1px solid transparent;}
QToolButton#IconPickerButton {background-color: transparent; border: 1px solid transparent; border-radius: 8px; padding: 1px 2px 3px 2px; color: #e0e4eb;}
QToolButton#IconPickerButton:hover {background-color: #292f3c; border-color: #3b445c;}
QToolButton#IconPickerButton[selected="true"] {background-color: rgba(71, 140, 191, 0.22); border: 2px solid #478cbf; color: #5aa1d5;}
QPushButton#PortraitTile {padding: 0px; min-width: 74px; min-height: 74px; border-radius: 8px;}
QLabel#PortraitIndex {color: #95a0bd; font-size: 11px; padding: 0px;}

/* ── 活动槽位按钮 (save_editor) ── */
QPushButton[active="true"] {font-weight: bold; color: #478cbf;}
QPushButton[active="false"] {font-weight: normal; color: #dcdcdc;}

/* ── Chip 小标签 (item_editor) ── */
QLabel[class="ChipLabel"] {font-size: 10px;}

/* ── 等宽文本区 (字段来源弹窗) ── */
QTextEdit[class="MonoText"] {font-family: 'Consolas', 'Courier New', monospace; font-size: 9pt;}

/* ── 紧凑树控件 (mat_editor 场景/实体列表) ── */
QTreeWidget[class="CompactTree"] {font-size: 12px;}
QTreeWidget[class="CompactTree"]::item {padding: 2px 4px; min-height: 22px;}
QTreeWidget[class="CompactTree"] QHeaderView::section {padding: 4px 6px; font-weight: bold;}

/* ── 成长率表格 (warpc_editor) ── */
QTableWidget[class="GrowthTable"]::item {background-color: #1a1e27;}
QTableWidget[class="GrowthTable"]::item:alternate {background-color: #202531;}
QTableWidget[class="GrowthTable"]::item:selected {background-color: #478cbf; color: #ffffff;}

/* ── 表格编辑模式 (warpc_editor) ── */
QTableView[class="WarpcGrid"] {alternate-background-color: #202531; gridline-color: #2a303d;}
QTableView[class="WarpcGrid"]::item:selected {background-color: #478cbf; color: #ffffff;}
QTableView[class="WarpcGrid"] QTableCornerButton::section {background-color: #202531; border: none;}

/* ── 类型字段标签 (mat_editor 实体参数) ── */
QLabel[class="TypeFieldLabel"] {color: #cc6600;}

/* ── 颜色色块 (mat/grp/wardata 色块通用) ── */
QFrame[class="ColorSwatch"], QLabel[class="ColorSwatch"] {background-color: #000000; border: 1px solid #666; border-radius: 6px;}

/* ── 色块按钮 - 圆形 (tkt_editor 工具栏颜色快捷键) ── */
QPushButton[class="ColorSwatchRound"] {border: 1px solid #777; border-radius: 10px; padding: 0px;}
QPushButton[class="ColorSwatchRound"]:hover {border: 2px solid #478cbf;}
QPushButton[class="ColorSwatchRound"]:focus {border: 2px solid #478cbf;}
QPushButton[class="ColorSwatchRound"]:pressed {border: 2px solid #ffffff;}

/* ── 色块按钮 - 方形 (tkt_editor 调色板弹窗) ── */
QPushButton[class="ColorSwatchBtn"] {border: 1px solid #555; border-radius: 6px; padding: 0px;}
QPushButton[class="ColorSwatchBtn"]:hover {border: 2px solid #478cbf;}
QPushButton[class="ColorSwatchBtn"]:focus {border: 2px solid #478cbf;}
QPushButton[class="ColorSwatchBtn"]:pressed {border: 2px solid #ffffff;}

/* ── 存档编辑器的槽位与表格状态 ── */
QPushButton[class="SaveSlotButton"] {min-width: 32px; min-height: 18px; padding: 4px 8px; background-color: transparent; border-color: transparent; border-radius: 8px;}
QPushButton[class="SaveSlotButton"]:hover {background-color: #2d3446; border-color: #414a63;}
QPushButton[class="SaveSlotButton"][active="true"] {background-color: rgba(71, 140, 191, 0.22); color: #5aa1d5; border-color: #478cbf; font-weight: bold;}
QLabel[class="SaveStatusLabel"] {color: #95a0bd; background-color: #292f3c; border: 1px solid #3b445c; border-radius: 8px; padding: 4px 10px;}
/* ── 当前队伍成员卡片 (save_editor 总览) ── */
QWidget[class="TeamMemberCard"] {background-color: #292f3c; border: 1px solid #3b445c; border-radius: 10px;}
QLabel[class="TeamMemberIndex"] {color: #838eab; font-size: 11px;}
QLabel[class="TeamMemberName"] {color: #e0e4eb; font-size: 13px; font-weight: 600; padding-top: 2px;}
QLabel[class="TeamMemberLevel"] {color: #5a9ccc; font-size: 12px; padding-top: 2px;}
QLabel[class="TeamMemberAvatar"] {background-color: #212632; border: 1px solid #323a4f; border-radius: 8px;}
QTableWidget#SaveInventoryTable,
QTableWidget#SaveWarpcTable {border-radius: 10px;}
QTabWidget#SaveEditorTabs QTabBar::tab {padding-left: 15px; padding-right: 15px; font-weight: 600;}
QTabWidget#SaveEventTabs QTabBar::tab {padding: 6px 10px; font-size: 12px;}

/* ── 路径状态标签 (loaded/missing/unloaded) ── */
QLabel[status="loaded"] {color: #55b572;}
QLabel[status="missing"] {color: #e27d60;}
QLabel[status="unloaded"] {color: #888;}

/* ── 方向指示复选框 (mat_editor) ── */
QCheckBox[class="DirCheckBox"] {font-size: 11px;}

/* ── 提示文本标签 (输入框下方, 无左距) ── */
QLabel[class="FieldHint"] {padding-left: 0px; font-size: 11px; color: #55b572;}

/* ── 脏标记标签 (tkt_editor): 简体字警告, 色值取自原内嵌样式 #ff6b6b ── */
QLabel[class="DirtyIndicator"] {color: #e27d60; font-weight: bold;}

/* ── 未保存标签 (tkt_editor): 还原 Tag 1.2 的实际渲染 (继承 DirtyIndicator 规则) ── */
QLabel[class="DirtyUnsaved"] {color: #f0a27e; font-weight: bold;}

/* ── 未知字段标签 (mat_editor “全部”页 d-index) ── */
QLabel[class="UnknownFieldLabel"] {color: #888;}

/* ── 探针标签 (act_editor 层/音效状态) ── */
QLabel[probe="ok"] {color: #55b572;}
QLabel[probe="warn"] {color: #CC6600;}
QLabel[probe="error"] {color: #CC3333;}
QLabel[probe="empty"] {color: #AAAAAA;}

/* ── 信息标题标签 (mat_editor 脚本预览) ── */
QLabel[class="InfoTitle"] {font-size: 13px; font-weight: bold;}

/* ── 缩放按钮 (tkt/spritesheet 编辑器) ── */
QPushButton[class="ZoomBtn"] {padding: 0px; font-size: 12px;}

/* ── 缩放比例标签 ── */
QLabel[class="ZoomLabel"] {font-size: 11px; background-color: transparent;}

/* ── 透明背景容器 (scroll content) ── */
QWidget#TransparentBg {background: transparent;}

/* ── 主标题标签 (tkt_editor 蓝色强调) ── */
QLabel[class="PrimaryTitle"] {font-weight: bold; color: #478cbf;}

/* ── 副标题标签 (tkt_editor 绿色强调) ── */
QLabel[class="SecondaryTitle"] {font-weight: bold; color: #55b572; padding-top: 10px;}

/* ── 确认操作按钮 (tkt_editor) ── */
QPushButton[class="ConfirmBtn"] {font-weight: bold; padding: 8px; margin-top: 10px; border-radius: 8px;}

/* ── 分隔线框架 (QFrame separator) ── */
QFrame[class="SepLine"] {color: #555; background-color: #3b445c; border: none; max-height: 1px;}
QFrame[class="VSepLine"] {color: #3b445c; background-color: #3b445c; border: none; min-width: 1px; max-width: 1px; min-height: 1px;}

/* ── 游戏预览区 (tkt_editor 模拟游戏文本渲染背景) ── */
QScrollArea#GamePreview, QTextEdit#GamePreview {/* tkt_editor 2D 视口的游戏预览色，必须与渲染器固定色一致 */
    background-color: #191d26; border: none;}
QTextEdit#GamePreview {color: #ffffff;}

/* ── configs_editor ── */

QFrame#Toolbar {max-height: 36px;}

/* 召唤编辑对话框 — 目标选择器显示区 */
QWidget[class="TargetDisplay"] {border: 1px solid #14171f; border-radius: 3px; background-color: #1a1e27;}
QLabel[class="TargetIcon"], QLabel[class="TargetName"] {border: none; background: transparent; color: #dcdcdc;}
QLabel[class="TargetName"] {padding: 2px 0px;}

/* 召唤表面板 — TKS目录未加载提示条 */
QFrame#SummonHintBar {background-color: rgba(255, 193, 7, 0.12); border-radius: 4px;}
QLabel#SummonHintLabel {color: #FFA000; background: transparent;}

/* 掉落概率面板 — 常规槽标签 */
QLabel#RegularPctLabel {font-weight: bold; color: #55b572;}

/* Config editor controls share the surrounding group-box surface. */
QGroupBox[configEditorSurface="true"] {background-color: transparent;}
QGroupBox[configEditorSurface="true"] QSlider {background-color: transparent;}
QGroupBox[configEditorSurface="true"] QSlider::groove:horizontal {background-color: transparent; border: 1px solid #3b445c;}
QGroupBox[configEditorSurface="true"] QSlider::sub-page:horizontal {background-color: rgba(71, 140, 191, 0.28); border-radius: 3px;}
QGroupBox[configEditorSurface="true"] QSlider::handle:horizontal {background-color: #6c7793;}
QGroupBox[configEditorSurface="true"] QSlider::handle:horizontal:hover {background-color: #478cbf;}
QGroupBox[configEditorSurface="true"] QSpinBox,
QGroupBox[configEditorSurface="true"] QDoubleSpinBox,
QGroupBox[configEditorSurface="true"] QComboBox {background-color: transparent; border-color: #3b445c;}
QGroupBox[configEditorSurface="true"] QSpinBox:hover,
QGroupBox[configEditorSurface="true"] QDoubleSpinBox:hover,
QGroupBox[configEditorSurface="true"] QComboBox:hover {border-color: #505a74;}
QGroupBox[configEditorSurface="true"] QSpinBox:focus,
QGroupBox[configEditorSurface="true"] QDoubleSpinBox:focus,
QGroupBox[configEditorSurface="true"] QComboBox:focus {border-color: #478cbf;}
QGroupBox[configEditorSurface="true"] QCheckBox,
QGroupBox[configEditorSurface="true"] QRadioButton {background: transparent;}
QGroupBox[configEditorSurface="true"] QCheckBox::indicator,
QGroupBox[configEditorSurface="true"] QRadioButton::indicator {background-color: transparent; border-color: #505a74;}
QGroupBox[configEditorSurface="true"] QCheckBox::indicator:hover,
QGroupBox[configEditorSurface="true"] QRadioButton::indicator:hover {border-color: #478cbf;}
QGroupBox[configEditorSurface="true"] QCheckBox::indicator:checked,
QGroupBox[configEditorSurface="true"] QRadioButton::indicator:checked {background-color: #478cbf; border-color: #478cbf;}

/* 状态栏标签 — configs_editor */
QLabel#ConfigDirLabel[status="loaded"],
QLabel#StatusWarpcLabel[status="loaded"],
QLabel#StatusTktLabel[status="loaded"],
QLabel#StatusFaLabel[status="loaded"] {color: #55b572; font-weight: bold;}
QLabel#ConfigDirLabel[status="missing"],
QLabel#StatusWarpcLabel[status="missing"],
QLabel#StatusTktLabel[status="missing"],
QLabel#StatusFaLabel[status="missing"] {color: #e27d60;}
QLabel#ConfigDirLabel[status="unloaded"],
QLabel#StatusWarpcLabel[status="unloaded"],
QLabel#StatusTktLabel[status="unloaded"],
QLabel#StatusFaLabel[status="unloaded"] {color: #888888;}
QLabel#StatusSkillLabel[status="loaded"] {color: #55b572; font-weight: bold;}
QLabel#StatusSkillLabel[status="missing"] {color: #e27d60;}
QLabel#StatusSkillLabel[status="unloaded"] {color: #888888;}

/* WarPC 选择器 — 已选提示栏 */
QLabel#WarpcSelectedLabel {padding: 4px; border-radius: 4px; background: rgba(255, 255, 0, 0.08);}

/* ── 字形单元格 (font_editor) ── */
QLabel[class="GlyphCell"] {background-color: #1a1e27; border: 1px solid #14171f;}

/* ══ 功能补充规则 (bab68ba 提交后新增组件所需, 配色沿用本主题色板) ══ */

/* ── 启动状态警告标签 (tks_launcher_gui): 半成功/部分未应用 ── */
QLabel#statusLabelWarn {color: #e8a040; font-weight: bold; padding: 4px 8px;}

/* ── 启动游戏分割按钮容器 (tks_launcher_gui): 透明背景避免圆角外侧出现锐角阴影 ── */
QWidget#startSplitButton {background-color: transparent; border: none; padding: 0px;}

/* ── 兼容模式启动按钮 (tks_launcher_gui): 蓝色区分标准模式绿 ── */
QPushButton#btnStartCompat {background-color: #303b52; color: #e5edff; border: 1px solid #7aa2f7; font-weight: bold;}
QPushButton#btnStartCompat:hover {background-color: #384967;}
QPushButton#btnStartCompat:pressed {background-color: #26344a; color: #ffffff;}
/* 兼容模式禁用: 边框色与启用态完全一致 (与齿轮按钮边框色一体化), 仅背景与文字变浅表示禁用 */
QPushButton#btnStartCompat:disabled {
    background-color: #2a3148;
    color: #8a99c2;
    border-color: #7aa2f7;
}

/* ── 启动游戏分割按钮: 主按钮圆左角, 齿轮按钮圆右角, 拼接处共享分隔线 ── */
QPushButton#btnStart,
QPushButton#btnStartCompat {border-top-right-radius: 0px; border-bottom-right-radius: 0px;}
QPushButton#btnStartGear {background-color: #2b5f3a; color: #e0f5e5; border: 1px solid #1e4a2c; border-left: none; border-top-left-radius: 0px; border-bottom-left-radius: 0px; padding: 6px 9px;}
QPushButton#btnStartGear:hover {background-color: #367a4a;}
QPushButton#btnStartGear:pressed {background-color: #1e4a2c; color: #ffffff;}
/* 齿轮按钮永远不允许禁用 — :disabled 样式与默认完全相同, 杜绝视觉差异 */
QPushButton#btnStartGear:disabled {
    background-color: #2b5f3a;
    color: #e0f5e5;
    border-color: #1e4a2c;
}
QPushButton#btnStartGearCompat {background-color: #303b52; color: #e5edff; border: 1px solid #7aa2f7; border-left: none; border-top-left-radius: 0px; border-bottom-left-radius: 0px; padding: 6px 9px;}
QPushButton#btnStartGearCompat:hover {background-color: #384967;}
QPushButton#btnStartGearCompat:pressed {background-color: #26344a; color: #ffffff;}
/* 兼容模式齿轮按钮 — :disabled 与启用态完全相同, 始终保持可点击视觉 */
QPushButton#btnStartGearCompat:disabled {
    background-color: #303b52;
    color: #e5edff;
    border-color: #7aa2f7;
}

/* ── 兼容模式蒙板 (补丁列表): 圆角与 DockHeader/DockBody 一致 ── */
QWidget#compatOverlay {background-color: rgba(0, 0, 0, 0.45); border-radius: 10px;}
QLabel#compatOverlayLabel {background: transparent; color: #ffffff; font-size: 14px; font-weight: bold;}

/* ── 启动状态面板当前模式值着色 (tks_launcher_gui) ── */
QLabel#modeValueStd {color: #478cbf; font-weight: bold;}
QLabel#modeValueCompat {color: #91b2ff; font-weight: bold;}

/* ── 表头全选复选框 (launcher 列表) ── */
QCheckBox#headerCheck {background: transparent;}

/* ── 详情区 / 对话框 / 预览占位 (launcher) ── */
QTextBrowser#detailBox {background-color: transparent; border: none; color: #e0e4eb;}
QDialog {background-color: #212632;}
QLabel#previewThumb {border: 2px dashed #39425a; border-radius: 6px; background-color: #292f3c; color: #838eab;}
QLabel#avatarPreview {border: 1px solid #2d3446; background-color: #292f3c;}

/* ── 播放状态标签 (custom_music_dialog) ── */
QLabel#nowPlaying {color: #838eab;}
QLabel#nowPlaying[state="playing"] {color: #478cbf;}

/* ── 学习模式提示 / 技能溢出警告 (warpc_editor) ── */
QLabel#learnModeHint {color: #478cbf; font-size: 11px; padding: 2px 0 4px 0;}
QLabel#overflowBanner {color: #ffffff; background-color: #c0392b; font-weight: bold; padding: 6px; border-radius: 4px;}

/* ── 定位闪烁高亮 (warpc_editor 字段定位) ── */
QLabel[class="FlashHint"] {background-color: #e8a040; color: #171a21; border-radius: 3px; padding: 1px 3px;}

/* ── 状态 chips (tks_book) ── */
QWidget[class="Chip"] {background-color: #2d3446; border: 1px solid #414a63; border-radius: 6px;}

/* ── MOD 分类 Tag 标签 (mod_list 分类列, 按类型着色) ── */
QLabel[class="TagVisual"]   {color: #e59ac6; background: rgba(229,154,198,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagAvatar"]   {color: #e8a26a; background: rgba(232,162,106,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagMusic"]    {color: #8fd48f; background: rgba(143,212,143,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagStory"]    {color: #7ecbd4; background: rgba(126,203,212,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagGameplay"] {color: #7fb3f2; background: rgba(127,179,242,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagSave"]     {color: #d4b06e; background: rgba(212,176,110,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagExe"]      {color: #e58f8f; background: rgba(229,143,143,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagConfig"]   {color: #a8b3c7; background: rgba(168,179,199,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagMixed"]    {color: #b79ae0; background: rgba(183,154,224,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagOther"]    {color: #9aa3b5; background: rgba(154,163,181,0.14); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagFont"]     {color: #d7b9a5; background: rgba(215,185,165,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagInterface"]{color: #9fa8da; background: rgba(159,168,218,0.16); border-radius: 3px; padding: 1px 6px;}
QLabel[class="TagMap"]      {color: #c5e1a5; background: rgba(197,225,165,0.16); border-radius: 3px; padding: 1px 6px;}

/* ── tks_book 语义值标签 ── */
QLabel[class="BookInfo"], QLabel[class="BookOk"], QLabel[class="BookBad"],
QLabel[class="BookSpecial"], QLabel[class="BookGold"], QLabel[class="BookMeta"],
QLabel[class="BookMuted"] {padding: 0px;}
QLabel[class="BookInfo"]    {color: #6699cc;}
QLabel[class="BookOk"]      {color: #5a9ccc;}
QLabel[class="BookBad"]     {color: #ef7777;}
QLabel[class="BookSpecial"] {color: #b58fd9;}
QLabel[class="BookGold"]    {color: #d4a855;}
QLabel[class="BookMeta"]    {color: #7ab8d4;}
QLabel[class="BookMuted"]   {color: #838eab;}

/* ══ TKS Launcher 视觉优化 ══ */
QMainWindow#LauncherWindow,
QWidget#LauncherRoot {background-color: #1d212d;}
QToolBar#LauncherToolbar {background-color: #14171f; border-bottom: 1px solid #2d3344; padding: 8px 12px; spacing: 8px; min-height: 42px;}
QToolBar#LauncherToolbar::separator {width: 1px; background-color: #3b445c; margin: 7px 3px;}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary {background-color: #292f3c; color: #aab4cd; border: 1px solid #3b445c; border-radius: 8px; padding: 7px 12px;}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary:hover {background-color: #323a4f; color: #e0e4eb; border-color: #505a74;}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary:pressed {background-color: #39425a; border-color: #478cbf;}
QWidget#LauncherModeBar {background-color: transparent; border: none; padding: 0px;}
QSplitter#LauncherSplitter {background-color: #1d212d;}
QSplitter#LauncherSplitter::handle:horizontal,
QSplitter#LauncherRightSplitter::handle:vertical {background-color: #1d212d; border: none; margin: 0;}
/* ── Dock 卡片化 (ChatGPT 风格): 标题栏只圆上角, 主体圆下角, 边框连成完整圆角卡片 ──
   (修复模组信息/画面兼容工具面板左下右直角边框、启动状态面板底部直角) */
QWidget#LauncherPatchPanel QFrame#DockHeader,
QWidget#LauncherModPanel QFrame#DockHeader,
QWidget#LauncherPreviewPanel QFrame#DockHeader,
QWidget#LauncherStatusPanel QFrame#DockHeader,
QWidget#LauncherToolsPanel QFrame#DockHeader {background-color: #191c24; border: 1px solid #323a4f; border-bottom: none; border-top-left-radius: 10px; border-top-right-radius: 10px;}
QWidget#LauncherPatchPanel QWidget#DockBody,
QWidget#LauncherModPanel QWidget#DockBody,
QWidget#LauncherPreviewPanel QWidget#DockBody,
QWidget#LauncherStatusPanel QWidget#DockBody,
QWidget#LauncherToolsPanel QWidget#DockBody {background-color: #212632; border: 1px solid #323a4f; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;}
/* 列表面板内容容器透明以露出 DockBody 表面 (表格由 body_margins 内收避开圆角) */
QWidget#LauncherPatchPanel QWidget#TransparentBg,
QWidget#LauncherModPanel QWidget#TransparentBg {background-color: transparent;}
QWidget#LauncherPatchPanel QToolButton#dockToolButton,
QWidget#LauncherModPanel QToolButton#dockToolButton {max-height: 24px; padding: 4px 8px; border-radius: 6px;}
QTableWidget#LauncherPatchTable,
QTableWidget#LauncherModTable {background-color: #212632; border: 1px solid #323a4f; border-radius: 8px; gridline-color: #32394e; alternate-background-color: #212632;}
/* 行/列分隔线统一由 gridline-color 绘制 (1px), ::item 不再加 border-bottom 避免双线叠加 */
QTableWidget#LauncherPatchTable::item,
QTableWidget#LauncherModTable::item {background-color: transparent; padding: 4px 8px;}
QTableWidget#LauncherPatchTable::item:selected,
QTableWidget#LauncherModTable::item:selected {background-color: rgba(71, 140, 191, 0.22); color: #e0e4eb;}
/* 表头顶部圆角: 表头组件自身圆角背景, section 透明以避免直角盖住卡片圆角 */
QTableWidget#LauncherPatchTable QHeaderView,
QTableWidget#LauncherModTable QHeaderView {background-color: #212632; border-top-left-radius: 7px; border-top-right-radius: 7px;}
QTableWidget#LauncherPatchTable QHeaderView::section,
QTableWidget#LauncherModTable QHeaderView::section {background-color: transparent; border-bottom: 1px solid #3b445c; padding: 8px; color: #95a0bd;}
QTextBrowser#detailBox {background-color: #212632; border: 1px solid #323a4f; border-radius: 10px; color: #e0e4eb; padding: 12px 14px;}
/* 模组信息面板: 详情文档以圆角内嵌组件形式适配 DockBody 圆角 */
QWidget#LauncherPreviewPanel QTextBrowser#detailBox {background-color: transparent; border: 1px solid #323a4f; border-radius: 8px; padding: 8px 10px;}
/* 内容容器透明, 露出 DockBody 圆角表面 (不透明背景会盖住底部圆角) */
QWidget#LauncherSummaryContent,
QWidget#LauncherToolsContent {background-color: transparent;}
QLabel[class="SummaryValue"] {color: #e0e4eb; font-weight: 600;}
QLabel#modeValueStd,
QLabel#modeValueCompat {border-radius: 6px; padding: 2px 8px; font-weight: bold;}
QLabel#modeValueStd {color: #5a9ccc; background-color: rgba(71, 140, 191, 0.16);}
QLabel#modeValueCompat {color: #91b2ff; background-color: rgba(122, 162, 247, 0.16);}
/* 启动状态值去除内边距, 与上方各行值左对齐 */
QWidget#LauncherSummaryContent QLabel#statusLabel,
QWidget#LauncherSummaryContent QLabel#statusLabelOk,
QWidget#LauncherSummaryContent QLabel#statusLabelWarn,
QWidget#LauncherSummaryContent QLabel#statusLabelError {padding: 0px;}
/* 启动状态行内按钮 (启动状态值右侧, 靠右对齐) */
QPushButton#showLogInlineButton {background-color: transparent; color: #5a9ccc; border: none; border-radius: 6px; padding: 3px 8px;}
QPushButton#showLogInlineButton:hover {background-color: #2d3446; color: #e0e4eb;}
QPushButton#showLogInlineButton:pressed {background-color: #39425a;}
QWidget#LauncherToolsContent QRadioButton {background-color: #292f3c; border: 1px solid #3b445c; border-radius: 7px; padding: 5px 9px;}
QWidget#LauncherToolsContent QRadioButton:hover {border-color: #505a74; background-color: #323a4f;}
QWidget#LauncherToolsContent QRadioButton:checked {color: #5a9ccc; border-color: #478cbf; background-color: rgba(71, 140, 191, 0.16);}
QStatusBar#LauncherStatusBar {background-color: #14171f; border-top: 1px solid #2d3344; padding: 3px 10px;}
QLabel#enabledModSummary,
QLabel#gameDirSummary {color: #95a0bd; padding: 4px 10px;}
