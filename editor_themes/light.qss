/* ChatGPT Desktop 风格浅色主题 — 干净白底 + 绿色交互强调 */
/* 应用底色 #ffffff / 侧栏 #f7f7f8 / 边框 #d9d9e3 / 强调色 #10a37f */

QWidget {
    background-color: #ffffff;
    color: #2d2d2d;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 13px;
}
QMainWindow, QDialog {
    background-color: #ffffff;
}
QToolTip {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #9a9aa6;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ── 表格、树与通用项目视图 ── */
QAbstractItemView {
    background-color: #ffffff;
    color: #2d2d2d;
    selection-background-color: rgba(16, 163, 127, 0.14);
    selection-color: #2d2d2d;
    outline: none;
}
QTableWidget, QTreeWidget, QTableView, QTreeView {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    gridline-color: #ececf1;
    selection-background-color: rgba(16, 163, 127, 0.14);
    selection-color: #2d2d2d;
    alternate-background-color: #f7f7f8;
    outline: none;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #f1f1f1;
}
QHeaderView {
    background-color: #f7f7f8;
}
QHeaderView::section {
    background-color: #f7f7f8;
    color: #6e6e80;
    border: none;
    border-bottom: 1px solid #d9d9e3;
    padding: 7px 8px;
}
QTableCornerButton::section {
    background-color: #f7f7f8;
    border: none;
    border-bottom: 1px solid #d9d9e3;
}

/* ── 文本输入 ── */
QPlainTextEdit, QLineEdit, QTextEdit {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    padding: 7px 9px;
    border-radius: 8px;
    selection-background-color: #10a37f;
    selection-color: #ffffff;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #b6b6c4;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #10a37f;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #f7f7f8;
    color: #9a9aa6;
    border-color: #ececf1;
}

/* ── 按钮与工具按钮 ── */
QPushButton {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #f1f1f1;
    border-color: #b6b6c4;
}
QPushButton:focus {
    border-color: #10a37f;
}
QPushButton:pressed {
    background-color: #e7e7e7;
    border-color: #10a37f;
}
QPushButton:disabled {
    background-color: #f7f7f8;
    color: #9a9aa6;
    border-color: #ececf1;
}
QPushButton:flat {
    background-color: transparent;
    border-color: transparent;
}
QPushButton:flat:hover {
    background-color: #f1f1f1;
    border-color: transparent;
}
QPushButton:flat:pressed {
    background-color: rgba(16, 163, 127, 0.14);
}
QToolButton {
    background-color: transparent;
    color: #6e6e80;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 8px;
}
QToolButton:hover {
    background-color: #f1f1f1;
    color: #2d2d2d;
    border-color: #d9d9e3;
}
QToolButton:pressed, QToolButton:checked {
    background-color: rgba(16, 163, 127, 0.14);
    color: #087f63;
    border-color: #10a37f;
}

/* ── 下拉框与数值输入 ── */
QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    padding: 6px 9px;
    min-height: 18px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {
    border-color: #b6b6c4;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #10a37f;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    selection-background-color: #10a37f;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}
QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    padding-right: 24px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #f7f7f8;
    width: 20px;
    border-left: 1px solid #d9d9e3;
    border-bottom: 1px solid #d9d9e3;
    border-top-right-radius: 7px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow, QTimeEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: url(svg/up-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #f7f7f8;
    width: 20px;
    border-left: 1px solid #d9d9e3;
    border-top: 1px solid #d9d9e3;
    border-bottom-right-radius: 7px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #ececf1;
}

/* ── 列表与选择器 ── */
QListWidget {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    outline: none;
}
QListWidget::item, QTreeWidget::item {
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: rgba(16, 163, 127, 0.14);
    color: #2d2d2d;
}
QListWidget::indicator, QTableWidget::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b6b6c4;
    border-radius: 5px;
}
QListWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: #10a37f;
    border-color: #10a37f;
    image: url(svg/checkmark.svg);
}
QListWidget::indicator:hover, QTableWidget::indicator:hover {
    border-color: #10a37f;
}

/* ── 分组框、复选框与单选按钮 ── */
QGroupBox {
    background-color: #f7f7f8;
    border: 1px solid #d9d9e3;
    border-radius: 10px;
    margin-top: 16px;
    padding: 14px 10px 10px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #6e6e80;
}
QCheckBox, QRadioButton {
    color: #2d2d2d;
    spacing: 7px;
    padding: 3px 0;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b6b6c4;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #10a37f;
    border-color: #10a37f;
    image: url(svg/checkmark.svg);
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #10a37f;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #9a9aa6;
}

/* ── 分割线与滚动条 ── */
QSplitter::handle {
    image: none;
    background-color: transparent;
}
QSplitter::handle:horizontal {
    border-left: 1px solid #ececf1;
    margin-left: 3px;
    margin-right: 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #ececf1;
    margin-top: 3px;
    margin-bottom: 3px;
}
QSplitter::handle:horizontal:hover, QSplitter::handle:vertical:hover {
    border-color: #10a37f;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c4c4cc;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #10a37f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c4c4cc;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #10a37f;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── 菜单栏与菜单 ── */
QMenuBar {
    background-color: #ffffff;
    color: #6e6e80;
    border-bottom: 1px solid #ececf1;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #f1f1f1;
    color: #2d2d2d;
}
QMenuBar::item:pressed {
    background-color: rgba(16, 163, 127, 0.14);
    color: #087f63;
}
QMenu {
    background-color: #ffffff;
    color: #2d2d2d;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 7px 28px 7px 10px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #f1f1f1;
    color: #2d2d2d;
}
QMenu::separator {
    height: 1px;
    background-color: #ececf1;
    margin: 5px 7px;
}

/* ── Tab 页 ── */
QTabWidget::pane {
    border: 1px solid #d9d9e3;
    background-color: #ffffff;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8e8ea0;
    border: none;
    padding: 8px 13px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background: #f7f7f8;
    color: #087f63;
    border-bottom: 2px solid #10a37f;
}
QTabBar::tab:hover:!selected {
    background: #f1f1f1;
    color: #2d2d2d;
}

/* ── 编辑器面板、图形视图与滚动区域 ── */
QFrame#DockHeader {
    background-color: #f7f7f8;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QWidget#DockBody {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-top: none;
}
QLabel#DockTitle {
    background-color: transparent;
    color: #3f3f4d;
    font-weight: bold;
}
QGraphicsView {
    border: 1px solid #d9d9e3;
    background-color: #f7f7f8;
}
QScrollArea {
    background-color: #ffffff;
    border: none;
}
QSlider::groove:horizontal {
    background-color: #ececf1;
    border: 1px solid #d9d9e3;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background-color: #9a9aa6;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #10a37f;
}
QProgressBar {
    background-color: #f7f7f8;
    border: 1px solid #d9d9e3;
    border-radius: 6px;
    text-align: center;
    color: #2d2d2d;
}
QProgressBar::chunk {
    background-color: #10a37f;
    border-radius: 5px;
}

/* ── 状态栏与标签 ── */
QStatusBar {
    background-color: #ffffff;
    color: #8e8ea0;
    border-top: 1px solid #ececf1;
    padding: 2px 8px;
}
QLabel {
    color: #2d2d2d;
    background-color: transparent;
}
QLabel#StatusLabel {
    color: #6e6e80;
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusSep {
    color: #c4c4cc;
    font-size: 12px;
    padding: 0 2px;
}
QLabel#StatusInfo {
    color: #8e8ea0;
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusPixel {
    color: #9a9aa6;
    font-size: 11px;
    padding: 0 4px;
    font-family: 'Consolas', 'Courier New', monospace;
}
QLabel#hintLabel {
    color: #8e8ea0;
    font-size: 11px;
}
/* ── Inspector 标题 (kon/wardata/warpc) ── */
QLabel[class="InspectorTitle"] {
    font-weight: bold;
    color: #2d2d2d;
    border-bottom: 1px solid #d9d9e3;
    padding-bottom: 2px;
    margin-top: 8px;
}
QLabel[class="PropLabel"] {
    color: #444;
}

/* ── 预览区面板 (kon/wardata/warpc) ── */
QFrame#PreviewFrame {
    background-color: transparent;
    border: none;
    border-top: 2px solid #8caec7;
    border-bottom: 1px solid #d9d9e3;
    border-radius: 0px;
    margin-top: 4px;
    margin-bottom: 8px;
}
QLabel[class="PreviewName"] {
    color: #2d2d2d;
    font-size: 18px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI';
}
QLabel[class="PreviewMeta"] {
    color: #8e8ea0;
    font-size: 11px;
    border-bottom: 1px solid #ececf1;
    padding-bottom: 8px;
    margin-bottom: 4px;
}
QLabel[class="PreviewDesc"] {
    color: #178a39;
    font-size: 13px;
    padding-top: 4px;
}
QLabel[class="PreviewSubMeta"] {
    color: #c93b16;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
}

/* ── FakeInputBox 内凹输入框 (kon/wardata/warpc) ── */
QFrame#FakeInputBox {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-radius: 4px;
}
QFrame#FakeInputBox:hover, QFrame#FakeInputBox:focus-within {
    background-color: #ffffff;
    border: 1px solid #10a37f;
}
QFrame#FakeInputBox > QLineEdit {
    background: transparent;
    border: none;
    padding: 4px 8px;
    color: #2d2d2d;
    font-family: 'Consolas', 'Segoe UI';
    selection-background-color: #10a37f;
    selection-color: #ffffff;
}
QFrame#FakeInputBox > QPushButton {
    background: transparent;
    border: none;
    border-left: 1px solid #ececf1;
    border-right: 1px solid #ececf1;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px;
    color: #9a9aa6;
}
QFrame#FakeInputBox > QPushButton:hover {
    background-color: #ececf1;
    color: #2d2d2d;
}
QFrame#FakeInputBox > QPushButton:first-child:hover {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}
QFrame#FakeInputBox > QComboBox {
    border: none;
    background: transparent;
    padding: 4px 8px;
    color: #2d2d2d;
}
QFrame#FakeInputBox > QComboBox::drop-down {
    border: none;
}
QFrame[class="FakeInputSep"] {
    background-color: #ececf1;
    border: none;
}

/* ── 额外预览文本 ── */
QLabel[class="ExtraPreviewText"] {
    padding: 4px 8px;
    color: #178a39;
    font-size: 11px;
}

/* ── 拆分字段内部标签 ── */
QLabel[class="SplitFieldLabel"] {
    color: #8e8ea0;
    font-size: 11px;
    padding: 0 2px;
}

/* ── 状态掩码标签颜色 (kon) ── */
QLabel[class="StatusInflict"] {
    color: #cc3333;
    font-size: 11px;
}
QLabel[class="StatusRemove"] {
    color: #3366cc;
    font-size: 11px;
}

/* ── 弹窗高亮主按钮 ── */
QPushButton#PrimaryButton {
    background-color: #10a37f;
    color: #ffffff;
    border: 1px solid #0d8c6d;
    font-weight: bold;
}
QPushButton#PrimaryButton:hover {
    background-color: #1aaf89;
}
QPushButton#PrimaryButton:pressed {
    background-color: #0d8c6d;
}

/* ── 工具栏 (tks_launcher_gui) ── */
QToolBar {
    background-color: #f7f7f8;
    border-bottom: 1px solid #d9d9e3;
    padding: 4px;
    spacing: 6px;
}

/* ── 控制台日志文本区 (tks_launcher_gui) ── */
/* 注意: 文字颜色由 log_console.py 通过 HTML 内联样式控制, 此处不设置 color */
QTextEdit#LogConsole {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #10a37f;
    selection-color: #ffffff;
}

/* ── QCheckBox 禁用状态 ── */
QCheckBox::indicator:disabled {
    background-color: #f7f7f8;
    border-color: #f7f7f8;
}
QCheckBox::indicator:checked:disabled {
    background-color: #8CB8D9;
    border-color: #8CB8D9;
    image: url(svg/checkmark.svg);
}
/* 必选补丁复选框：禁用态文字保持正常颜色 */
QCheckBox#requiredPatch:disabled {
    color: #2d2d2d;
}

/* ── 滚动条悬停 (tks_launcher_gui) ── */
QScrollBar::handle:vertical:hover {
    background-color: #6e6e80;
}
QScrollBar::handle:horizontal:hover {
    background-color: #6e6e80;
}

/* ── 状态栏标签 (tks_launcher_gui) ── */
QLabel#statusLabel {
    color: #2d2d2d;
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelOk {
    color: #2E7D32;
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelError {
    color: #C62828;
    font-weight: bold;
    padding: 4px 8px;
}

/* ── DockHeader 内紧凑工具按钮 (tks_launcher_gui) ── */
QToolButton#dockToolButton {
    background-color: transparent;
    color: #2d2d2d;
    border: none;
    border-radius: 3px;
    padding: 0px 6px;
    max-height: 16px;
}
QToolButton#dockToolButton:hover {
    background-color: #ffffff;
}
QToolButton#dockToolButton:pressed {
    background-color: #10a37f;
    color: #fff;
}
QToolButton#dockToolButton:checked {
    background-color: #10a37f;
    color: #ffffff;
}
QToolButton#dockToolButton:checked:hover {
    background-color: #1aaf89;
    color: #ffffff;
}

/* ── 启动按钮高亮 (tks_launcher_gui) ── */
QPushButton#btnStart {
    background-color: #10a37f;
    color: #ffffff;
    border: 1px solid #0d8c6d;
    font-weight: bold;
}
QPushButton#btnStart:hover {
    background-color: #1aaf89;
}
QPushButton#btnStart:pressed {
    background-color: #0d8c6d;
    color: #ffffff;
}
QPushButton#btnStart:disabled {
    background-color: #f7f7f8;
    color: #6e6e80;
    border-color: #d9d9e3;
}

/* ── 记录标题标签 (item/skill/mat/warpc 编辑器) ── */
QLabel[class="RecordHeader"] {
    font-size: 14px;
    font-weight: bold;
}

/* ── 状态提示标签 (mat_editor) ── */
QLabel[class="StatusHint"] {
    color: #8e8ea0;
    font-size: 11px;
}

/* ── 紧凑按钮 (mat_editor 工具栏) ── */
QPushButton[class="CompactBtn"] {
    padding-left: 4px;
    padding-right: 4px;
}

/* ── 打包/操作主按钮 (launcher dialogs) ── */
QPushButton#btnPack {
    font-weight: bold;
    padding: 6px 20px;
}

/* ── 图标选择器按钮 (item/warpc 编辑器) ── */
QPushButton[selected="true"] {
    background-color: #d0e8ff;
    border: 2px solid #10a37f;
}
QPushButton[selected="false"] {
    background-color: transparent;
    border: 1px solid transparent;
}

/* ── 活动槽位按钮 (save_editor) ── */
QPushButton[active="true"] {
    font-weight: bold;
    color: #10a37f;
}
QPushButton[active="false"] {
    font-weight: normal;
    color: #2d2d2d;
}

/* ── Chip 小标签 (item_editor) ── */
QLabel[class="ChipLabel"] {
    font-size: 10px;
}

/* ── 等宽文本区 (字段来源弹窗) ── */
QTextEdit[class="MonoText"] {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 9pt;
}

/* ── 紧凑树控件 (mat_editor 场景/实体列表) ── */
QTreeWidget[class="CompactTree"] {
    font-size: 12px;
}
QTreeWidget[class="CompactTree"]::item {
    padding: 2px 4px;
    min-height: 22px;
}
QTreeWidget[class="CompactTree"] QHeaderView::section {
    padding: 4px 6px;
    font-weight: bold;
}

/* ── 成长率表格 (warpc_editor) ── */
QTableWidget[class="GrowthTable"]::item {
    background-color: #ffffff;
}
QTableWidget[class="GrowthTable"]::item:alternate {
    background-color: #ffffff;
}
QTableWidget[class="GrowthTable"]::item:selected {
    background-color: #10a37f;
    color: #ffffff;
}

/* ── 表格编辑模式 (warpc_editor) ── */
QTableView[class="WarpcGrid"] {
    alternate-background-color: #ffffff;
    gridline-color: #f7f7f8;
}
QTableView[class="WarpcGrid"]::item:selected {
    background-color: #10a37f;
    color: #ffffff;
}
QTableView[class="WarpcGrid"] QTableCornerButton::section {
    background-color: #f7f7f8;
    border: none;
}

/* ── 类型字段标签 (mat_editor 实体参数) ── */
QLabel[class="TypeFieldLabel"] {
    color: #b85c00;
}

/* ── 颜色色块 (mat/grp/wardata 色块通用) ── */
QFrame[class="ColorSwatch"], QLabel[class="ColorSwatch"] {
    background-color: #000000;
    border: 1px solid #6e6e80;
    border-radius: 3px;
}

/* ── 色块按钮 - 圆形 (tkt_editor 工具栏颜色快捷键) ── */
QPushButton[class="ColorSwatchRound"] {
    border: 1px solid #6e6e80;
    border-radius: 10px;
    padding: 0px;
}
QPushButton[class="ColorSwatchRound"]:hover {
    border: 2px solid #10a37f;
}

/* ── 色块按钮 - 方形 (tkt_editor 调色板弹窗) ── */
QPushButton[class="ColorSwatchBtn"] {
    border: 1px solid #6e6e80;
    border-radius: 4px;
    padding: 0px;
}
QPushButton[class="ColorSwatchBtn"]:hover {
    border: 2px solid #10a37f;
}

/* ── 路径状态标签 (loaded/missing/unloaded) ── */
QLabel[status="loaded"] {
    color: #178a39;
}
QLabel[status="missing"] {
    color: #c93b16;
}
QLabel[status="unloaded"] {
    color: #8e8ea0;
}

/* ── 方向指示复选框 (mat_editor) ── */
QCheckBox[class="DirCheckBox"] {
    font-size: 11px;
}

/* ── 提示文本标签 (输入框下方, 无左距) ── */
QLabel[class="FieldHint"] {
    padding-left: 0px;
    font-size: 11px;
    color: #178a39;
}

/* ── 脏标记标签 (tkt_editor): 简体字警告, 色值取自原内嵌样式 #ff6b6b (深浅同色) ── */
QLabel[class="DirtyIndicator"] {
    color: #ff6b6b;
    font-weight: bold;
}

/* ── 未保存标签 (tkt_editor): 还原 Tag 1.2 浅色下的实际渲染 (继承 DirtyIndicator 规则) ── */
QLabel[class="DirtyUnsaved"] {
    color: #c93b16;
    font-weight: bold;
}

/* ── 未知字段标签 (mat_editor “全部”页 d-index) ── */
QLabel[class="UnknownFieldLabel"] {
    color: #8e8ea0;
}

/* ── 探针标签 (act_editor 层/音效状态) ── */
QLabel[probe="ok"] {
    color: #2E7D32;
}
QLabel[probe="warn"] {
    color: #B85C00;
}
QLabel[probe="error"] {
    color: #C62828;
}
QLabel[probe="empty"] {
    color: #6e6e80;
}

/* ── 信息标题标签 (mat_editor 脚本预览) ── */
QLabel[class="InfoTitle"] {
    font-size: 13px;
    font-weight: bold;
}

/* ── 缩放按钮 (tkt/spritesheet 编辑器) ── */
QPushButton[class="ZoomBtn"] {
    padding: 0px;
    font-size: 12px;
}

/* ── 缩放比例标签 ── */
QLabel[class="ZoomLabel"] {
    font-size: 11px;
    background-color: transparent;
}

/* ── 透明背景容器 (scroll content) ── */
QWidget#TransparentBg {
    background: transparent;
}

/* ── 主标题标签 (tkt_editor 蓝色强调) ── */
QLabel[class="PrimaryTitle"] {
    font-weight: bold;
    color: #10a37f;
}

/* ── 副标题标签 (tkt_editor 绿色强调) ── */
QLabel[class="SecondaryTitle"] {
    font-weight: bold;
    color: #2E7D32;
    padding-top: 10px;
}

/* ── 确认操作按钮 (tkt_editor) ── */
QPushButton[class="ConfirmBtn"] {
    font-weight: bold;
    padding: 8px;
    margin-top: 10px;
}

/* ── 分隔线框架 (QFrame separator) ── */
QFrame[class="SepLine"] {
    color: #aaa;
}

/* ── 游戏预览区 (tkt_editor 模拟游戏文本渲染背景) ── */
QScrollArea#GamePreview, QTextEdit#GamePreview {
    /* tkt_editor 2D 视口的游戏预览色，必须与渲染器固定色一致 */
    background-color: #313c52;
    border: none;
}
QTextEdit#GamePreview {
    color: #ffffff;
}

/* ── configs_editor ── */

QFrame#Toolbar {
    max-height: 36px;
}

/* 召唤编辑对话框 — 目标选择器显示区 */
QWidget[class="TargetDisplay"] {
    border: 1px solid #d9d9e3;
    border-radius: 3px;
    background-color: #ffffff;
}
QLabel[class="TargetIcon"], QLabel[class="TargetName"] {
    border: none;
    background: transparent;
    color: #2d2d2d;
}
QLabel[class="TargetName"] {
    padding: 2px 0px;
}

/* 召唤表面板 — TKS目录未加载提示条 */
QFrame#SummonHintBar {
    background-color: rgba(255, 193, 7, 0.18);
    border-radius: 4px;
}
QLabel#SummonHintLabel {
    color: #B8860B;
    background: transparent;
}

/* 掉落概率面板 — 常规槽标签 */
QLabel#RegularPctLabel {
    font-weight: bold;
    color: #178a39;
}

/* 状态栏标签 — configs_editor */
QLabel#ConfigDirLabel[status="loaded"],
QLabel#StatusWarpcLabel[status="loaded"],
QLabel#StatusTktLabel[status="loaded"],
QLabel#StatusFaLabel[status="loaded"] {
    color: #178a39;
    font-weight: bold;
}
QLabel#ConfigDirLabel[status="missing"],
QLabel#StatusWarpcLabel[status="missing"],
QLabel#StatusTktLabel[status="missing"],
QLabel#StatusFaLabel[status="missing"] {
    color: #c93b16;
}
QLabel#ConfigDirLabel[status="unloaded"],
QLabel#StatusWarpcLabel[status="unloaded"],
QLabel#StatusTktLabel[status="unloaded"],
QLabel#StatusFaLabel[status="unloaded"] {
    color: #8e8ea0;
}
QLabel#StatusSkillLabel[status="loaded"] {
    color: #178a39;
    font-weight: bold;
}
QLabel#StatusSkillLabel[status="missing"] {
    color: #c93b16;
}
QLabel#StatusSkillLabel[status="unloaded"] {
    color: #8e8ea0;
}

/* WarPC 选择器 — 已选提示栏 */
QLabel#WarpcSelectedLabel {
    padding: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 0, 0.12);
}

/* ── 字形单元格 (font_editor) ── */
QLabel[class="GlyphCell"] {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
}

/* ══ 功能补充规则 (bab68ba 提交后新增组件所需, 配色沿用本主题色板) ══ */

/* ── 启动状态警告标签 (tks_launcher_gui): 半成功/部分未应用 ── */
QLabel#statusLabelWarn {
    color: #CC6600;
    font-weight: bold;
    padding: 4px 8px;
}

/* ── 兼容模式启动按钮 (tks_launcher_gui): 蓝色区分标准模式绿 ── */
QPushButton#btnStartCompat {
    background-color: #eef2ff;
    color: #4f5bb5;
    border: 1px solid #7c83fd;
    font-weight: bold;
}
QPushButton#btnStartCompat:hover {
    background-color: #e3e8ff;
}
QPushButton#btnStartCompat:pressed {
    background-color: #d8dfff;
    color: #ffffff;
}
QPushButton#btnStartCompat:disabled {
    background-color: #f7f7f8;
    color: #6e6e80;
    border-color: #d9d9e3;
}

/* ── 启动游戏分割按钮: 主按钮圆左角, 齿轮按钮圆右角, 拼接处共享分隔线 ── */
QPushButton#btnStart,
QPushButton#btnStartCompat {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}
QPushButton#btnStartGear {
    background-color: #10a37f;
    color: #ffffff;
    border: 1px solid #0d8c6d;
    border-left: none;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    padding: 6px 9px;
}
QPushButton#btnStartGear:hover {
    background-color: #1aaf89;
}
QPushButton#btnStartGear:pressed {
    background-color: #0d8c6d;
    color: #ffffff;
}
QPushButton#btnStartGear:disabled {
    background-color: #f7f7f8;
    color: #6e6e80;
    border-color: #d9d9e3;
}
QPushButton#btnStartGearCompat {
    background-color: #eef2ff;
    color: #4f5bb5;
    border: 1px solid #7c83fd;
    border-left: none;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    padding: 6px 9px;
}
QPushButton#btnStartGearCompat:hover {
    background-color: #e3e8ff;
}
QPushButton#btnStartGearCompat:pressed {
    background-color: #d8dfff;
    color: #ffffff;
}
QPushButton#btnStartGearCompat:disabled {
    background-color: #f7f7f8;
    color: #6e6e80;
    border-color: #d9d9e3;
}

/* ── 兼容模式蒙板 (补丁列表): 圆角与 DockHeader/DockBody 一致 ── */
QWidget#compatOverlay {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 10px;
}
QLabel#compatOverlayLabel {
    background: transparent;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
}

/* ── 启动状态面板当前模式值着色 (tks_launcher_gui) ── */
QLabel#modeValueStd {
    color: #0d8c6d;
    font-weight: bold;
}
QLabel#modeValueCompat {
    color: #4f5bb5;
    font-weight: bold;
}

/* ── 表头全选复选框 (launcher 列表) ── */
QCheckBox#headerCheck {
    background: transparent;
}

/* ── 详情区 / 对话框 / 预览占位 (launcher) ── */
QTextBrowser#detailBox {
    background-color: transparent;
    border: none;
    color: #2d2d2d;
}
QDialog {
    background-color: #ffffff;
}
QLabel#previewThumb {
    border: 2px dashed #8e8ea0;
    border-radius: 6px;
    background-color: #f7f7f8;
    color: #6e6e80;
}
QLabel#avatarPreview {
    border: 1px solid #8e8ea0;
    background-color: #ffffff;
}

/* ── 播放状态标签 (custom_music_dialog) ── */
QLabel#nowPlaying {
    color: #8e8ea0;
}
QLabel#nowPlaying[state="playing"] {
    color: #10a37f;
}

/* ── 学习模式提示 / 技能溢出警告 (warpc_editor) ── */
QLabel#learnModeHint {
    color: #10a37f;
    font-size: 11px;
    padding: 2px 0 4px 0;
}
QLabel#overflowBanner {
    color: #ffffff;
    background-color: #c0392b;
    font-weight: bold;
    padding: 6px;
    border-radius: 4px;
}

/* ── 定位闪烁高亮 (warpc_editor 字段定位) ── */
QLabel[class="FlashHint"] {
    background-color: #e8a040;
    color: #1a1a1a;
    border-radius: 3px;
    padding: 1px 3px;
}

/* ── 状态 chips (tks_book) ── */
QWidget[class="Chip"] {
    background-color: #f7f7f8;
    border-radius: 3px;
}

/* ── MOD 分类 Tag 标签 (mod_list 分类列, 按类型着色) ── */
QLabel[class="TagVisual"]   { color: #b0308a; background: rgba(176,48,138,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagAvatar"]   { color: #b05a1a; background: rgba(176,90,26,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMusic"]    { color: #2e7d32; background: rgba(46,125,50,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagStory"]    { color: #00796b; background: rgba(0,121,107,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagGameplay"] { color: #1565c0; background: rgba(21,101,192,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagSave"]     { color: #8d6e00; background: rgba(141,110,0,0.12); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagExe"]      { color: #c62828; background: rgba(198,40,40,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagConfig"]   { color: #455a64; background: rgba(69,90,100,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMixed"]    { color: #6a3ab2; background: rgba(106,58,178,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagOther"]    { color: #606878; background: rgba(96,104,120,0.12); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagFont"]     { color: #5d4037; background: rgba(93,64,55,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagInterface"]{ color: #3949ab; background: rgba(57,73,171,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMap"]      { color: #558b2f; background: rgba(85,139,47,0.10); border-radius: 3px; padding: 1px 6px; }

/* ── tks_book 语义值标签 ── */
QLabel[class="BookInfo"], QLabel[class="BookOk"], QLabel[class="BookBad"],
QLabel[class="BookSpecial"], QLabel[class="BookGold"], QLabel[class="BookMeta"],
QLabel[class="BookMuted"] {
    padding: 0px;
}
QLabel[class="BookInfo"]    { color: #3366cc; }
QLabel[class="BookOk"]      { color: #178a39; }
QLabel[class="BookBad"]     { color: #cc3333; }
QLabel[class="BookSpecial"] { color: #7b4fa0; }
QLabel[class="BookGold"]    { color: #a07820; }
QLabel[class="BookMeta"]    { color: #2a6f8c; }
QLabel[class="BookMuted"]   { color: #8e8ea0; }

/* ══ TKS Launcher 视觉优化 ══ */
QMainWindow#LauncherWindow,
QWidget#LauncherRoot {
    background-color: #ffffff;
}
QToolBar#LauncherToolbar {
    background-color: #f7f7f8;
    border-bottom: 1px solid #ececf1;
    padding: 8px 12px;
    spacing: 8px;
    min-height: 42px;
}
QToolBar#LauncherToolbar::separator {
    width: 1px;
    background-color: #d9d9e3;
    margin: 7px 3px;
}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary {
    background-color: #ffffff;
    color: #6e6e80;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    padding: 7px 12px;
}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary:hover {
    background-color: #f1f1f1;
    color: #2d2d2d;
    border-color: #b6b6c4;
}
QToolBar#LauncherToolbar QPushButton#toolbarSecondary:pressed {
    background-color: #e7e7e7;
    border-color: #10a37f;
}
QWidget#LauncherModeBar {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QSplitter#LauncherSplitter {
    background-color: #ffffff;
}
QSplitter#LauncherSplitter::handle:horizontal,
QSplitter#LauncherRightSplitter::handle:vertical {
    background-color: #ffffff;
    border: none;
    margin: 0;
}
/* ── Dock 卡片化 (ChatGPT 风格): 标题栏只圆上角, 主体圆下角, 边框连成完整圆角卡片 ──
   (修复模组信息/画面兼容工具面板左下右直角边框、启动状态面板底部直角) */
QWidget#LauncherPatchPanel QFrame#DockHeader,
QWidget#LauncherModPanel QFrame#DockHeader,
QWidget#LauncherPreviewPanel QFrame#DockHeader,
QWidget#LauncherStatusPanel QFrame#DockHeader,
QWidget#LauncherToolsPanel QFrame#DockHeader {
    background-color: #f1f1f1;
    border: 1px solid #d9d9e3;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QWidget#LauncherPatchPanel QWidget#DockBody,
QWidget#LauncherModPanel QWidget#DockBody,
QWidget#LauncherPreviewPanel QWidget#DockBody,
QWidget#LauncherStatusPanel QWidget#DockBody,
QWidget#LauncherToolsPanel QWidget#DockBody {
    background-color: #f7f7f8;
    border: 1px solid #d9d9e3;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
/* 列表面板内容容器透明以露出 DockBody 表面 (表格由 body_margins 内收避开圆角) */
QWidget#LauncherPatchPanel QWidget#TransparentBg,
QWidget#LauncherModPanel QWidget#TransparentBg {
    background-color: transparent;
}
QWidget#LauncherPatchPanel QToolButton#dockToolButton,
QWidget#LauncherModPanel QToolButton#dockToolButton {
    max-height: 24px;
    padding: 4px 8px;
    border-radius: 6px;
}
QTableWidget#LauncherPatchTable,
QTableWidget#LauncherModTable {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    gridline-color: #e3e3e8;
    alternate-background-color: #ffffff;
}
/* 行/列分隔线统一由 gridline-color 绘制 (1px), ::item 不再加 border-bottom 避免双线叠加 */
QTableWidget#LauncherPatchTable::item,
QTableWidget#LauncherModTable::item {
    background-color: transparent;
    padding: 4px 8px;
}
QTableWidget#LauncherPatchTable::item:selected,
QTableWidget#LauncherModTable::item:selected {
    background-color: rgba(16, 163, 127, 0.14);
    color: #2d2d2d;
}
/* 表头顶部圆角: 表头组件自身圆角背景, section 透明以避免直角盖住卡片圆角 */
QTableWidget#LauncherPatchTable QHeaderView,
QTableWidget#LauncherModTable QHeaderView {
    background-color: #ffffff;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QTableWidget#LauncherPatchTable QHeaderView::section,
QTableWidget#LauncherModTable QHeaderView::section {
    background-color: transparent;
    border-bottom: 1px solid #d9d9e3;
    padding: 8px;
    color: #6e6e80;
}
QTextBrowser#detailBox {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-radius: 10px;
    color: #2d2d2d;
    padding: 12px 14px;
}
/* 模组信息面板: 详情文档以圆角内嵌组件形式适配 DockBody 圆角 */
QWidget#LauncherPreviewPanel QTextBrowser#detailBox {
    background-color: transparent;
    border: 1px solid #d9d9e3;
    border-radius: 8px;
    padding: 8px 10px;
}
/* 内容容器透明, 露出 DockBody 圆角表面 (不透明背景会盖住底部圆角) */
QWidget#LauncherSummaryContent,
QWidget#LauncherToolsContent {
    background-color: transparent;
}
QLabel[class="SummaryValue"] {
    color: #2d2d2d;
    font-weight: 600;
}
QLabel#modeValueStd,
QLabel#modeValueCompat {
    border-radius: 6px;
    padding: 2px 8px;
    font-weight: bold;
}
QLabel#modeValueStd {
    color: #087f63;
    background-color: rgba(16, 163, 127, 0.12);
}
QLabel#modeValueCompat {
    color: #4f5bb5;
    background-color: rgba(124, 131, 253, 0.14);
}
/* 启动状态值去除内边距, 与上方各行值左对齐 */
QWidget#LauncherSummaryContent QLabel#statusLabel,
QWidget#LauncherSummaryContent QLabel#statusLabelOk,
QWidget#LauncherSummaryContent QLabel#statusLabelWarn,
QWidget#LauncherSummaryContent QLabel#statusLabelError {
    padding: 0px;
}
/* 启动状态行内按钮 (启动状态值右侧, 靠右对齐) */
QPushButton#showLogInlineButton {
    background-color: transparent;
    color: #087f63;
    border: none;
    border-radius: 6px;
    padding: 3px 8px;
}
QPushButton#showLogInlineButton:hover {
    background-color: #f1f1f1;
    color: #2d2d2d;
}
QPushButton#showLogInlineButton:pressed {
    background-color: #e7e7e7;
}
QWidget#LauncherToolsContent QRadioButton {
    background-color: #ffffff;
    border: 1px solid #d9d9e3;
    border-radius: 7px;
    padding: 5px 9px;
}
QWidget#LauncherToolsContent QRadioButton:hover {
    border-color: #b6b6c4;
    background-color: #f1f1f1;
}
QWidget#LauncherToolsContent QRadioButton:checked {
    color: #087f63;
    border-color: #10a37f;
    background-color: rgba(16, 163, 127, 0.12);
}
QStatusBar#LauncherStatusBar {
    background-color: #f7f7f8;
    border-top: 1px solid #ececf1;
    padding: 3px 10px;
}
QLabel#enabledModSummary {
    color: #8e8ea0;
    padding: 4px 10px;
}
