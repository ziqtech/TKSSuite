/* Godot 4.7 编辑器风格浅色主题 — 全局共享主题 (所有编辑器统一使用) */
/* 色板源自 Godot 4.7 Light 预设: base #e6e6e6 / accent #2e80ff / contrast -0.06 推导 */

QWidget {
    background-color: #e6e6e6;
    color: rgba(0,0,0,0.75);
    font-family: 'Segoe UI', 'Microsoft YaHei';
    font-size: 14px;
}

/* ── 表格 ── */
QTableWidget, QTreeWidget, QTableView, QTreeView {
    background-color: #f6f6f6;
    color: rgba(0,0,0,0.75);
    border: none;
    border-radius: 4px;
    selection-background-color: #2e80ff;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #f5f5f5;
    color: rgba(0,0,0,0.55);
    border: none;
    border-bottom: 1px solid #b7b7b7;
    padding: 4px 8px;
}

/* ── 文本输入 ── */
QPlainTextEdit, QLineEdit, QTextEdit {
    background-color: #f5f5f5;
    border: 1px solid #f5f5f5;
    padding: 4px 8px;
    border-radius: 4px;
    selection-background-color: #2e80ff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #2e80ff;
}
QLineEdit:disabled {
    background-color: #f0f0f0;
    color: rgba(0,0,0,0.35);
    border: 1px solid #e3e3e3;
}

/* ── 按钮 ── */
QPushButton {
    background-color: #cacaca;
    border: 1px solid #c3c3c3;
    border-radius: 4px;
    padding: 5px 12px;
    color: rgba(0,0,0,0.75);
}
QPushButton:hover {
    background-color: #bebebe;
    border-color: #b7b7b7;
}
QPushButton:pressed {
    background-color: #b9b9b9;
    border-color: #b3b3b3;
    color: rgba(0,0,0,0.85);
}
QPushButton:disabled {
    background-color: #d2d2d2;
    color: rgba(0,0,0,0.5);
}

/* ── 下拉框 — 与输入框同层表面, 避免偏深 ── */
QComboBox {
    background-color: #f5f5f5;
    border: 1px solid #e3e3e3;
    border-radius: 4px;
    padding: 4px 8px;
    color: rgba(0,0,0,0.75);
}
QComboBox:hover {
    border-color: #b7b7b7;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: rgba(0,0,0,0.75);
    border: none;
    selection-background-color: #d5d5d5;
    selection-color: rgba(0,0,0,0.85);
    outline: none;
}

/* ── 数值输入 ── */
QSpinBox {
    background-color: #f5f5f5;
    color: rgba(0,0,0,0.75);
    border: 1px solid #f5f5f5;
    border-radius: 4px;
    padding: 2px 22px 2px 6px;
    min-width: 60px;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #cacaca;
    width: 18px;
    border-left: 1px solid #b7b7b7;
    border-bottom: 1px solid #b7b7b7;
    border-top-right-radius: 3px;
}
QSpinBox::up-arrow {
    image: url(svg/up-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #cacaca;
    width: 18px;
    border-left: 1px solid #b7b7b7;
    border-top: 1px solid #b7b7b7;
    border-bottom-right-radius: 3px;
}
QSpinBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #bebebe;
}
QSpinBox:focus {
    border-color: #2e80ff;
}

/* ── 列表控件 ── */
QListWidget {
    background-color: #f6f6f6;
    border: none;
    outline: none;
}
QListWidget::item {
    border: none;
    border-radius: 0;
    padding: 2px 4px;
}
QListWidget::item:selected {
    background-color: #2e80ff;
    color: white;
    border: none;
    border-radius: 0;
    outline: none;
}
QListWidget::indicator, QTableWidget::indicator {
    width: 16px;
    height: 16px;
    background-color: #f5f5f5;
    border: 1px solid #b7b7b7;
    border-radius: 3px;
}
QListWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: #2e80ff;
    border-color: #2e80ff;
    image: url(svg/checkmark.svg);
}
QListWidget::indicator:hover, QTableWidget::indicator:hover {
    border-color: #b3b3b3;
}

/* ── 分组框 ── */
QGroupBox {
    background-color: #e6e6e6;
    border: 1px solid #b7b7b7;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: rgba(0,0,0,0.85);
}

/* ── 复选框 ── */
QCheckBox {
    color: rgba(0,0,0,0.75);
    /* 透明背景: 避免被全局 QWidget 背景规则染成灰块 */
    background-color: transparent;
    spacing: 6px;
    padding: 2px 0px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #f5f5f5;
    border: 1px solid #b7b7b7;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #2e80ff;
    border-color: #2e80ff;
    image: url(svg/checkmark.svg);
}
QCheckBox::indicator:hover {
    border-color: #b3b3b3;
}
QCheckBox:disabled {
    color: rgba(0,0,0,0.5);
}

/* ── 单选按钮 ── */
QRadioButton {
    color: rgba(0,0,0,0.75);
    /* 透明背景: 避免被全局 QWidget 背景规则染成灰块 */
    background-color: transparent;
    spacing: 6px;
    padding: 2px 1px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #f5f5f5;
    border: 1px solid #b7b7b7;
    border-radius: 8px;
}
QRadioButton::indicator:checked {
    background-color: #2e80ff;
    border-color: #2e80ff;
    image: url(svg/checkmark.svg);
}
QRadioButton::indicator:hover {
    border-color: #b3b3b3;
}
QRadioButton:disabled {
    color: rgba(0,0,0,0.5);
}

/* ── 分割线 ── */
QSplitter::handle {
    image: none;
    background-color: transparent;
}
QSplitter::handle:horizontal {
    border-left: 1px solid #b7b7b7;
    margin-left: 3px;
    margin-right: 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #b7b7b7;
    margin-top: 3px;
    margin-bottom: 3px;
}
QSplitter::handle:horizontal:hover {
    border-left: 1px solid #2e80ff;
}
QSplitter::handle:vertical:hover {
    border-top: 1px solid #2e80ff;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: #ebebeb;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #bebebe;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #ebebeb;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #bebebe;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── 菜单栏 ── */
QMenuBar {
    background-color: #e6e6e6;
    color: rgba(0,0,0,0.75);
    border-bottom: 1px solid #b7b7b7;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}
QMenuBar::item:selected {
    background-color: #d5d5d5;
    border-radius: 4px;
}
QMenuBar::item:pressed {
    background-color: #b3b3b3;
    color: rgba(0,0,0,0.85);
}
QMenu {
    background-color: #ffffff;
    border: none;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 24px;
    border-radius: 4px;
    color: rgba(0,0,0,0.75);
}
QMenu::item:selected {
    background-color: #d5d5d5;
    color: rgba(0,0,0,0.85);
}
QMenu::separator {
    height: 1px;
    background-color: #b7b7b7;
    margin: 3px 6px;
}

/* ── Tab 页 — 选中项独立表面色 (与容器背景拉开对比) ── */
QTabWidget::pane {
    border: none;
    background-color: #e6e6e6;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    border: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: rgba(0,0,0,0.55);
}
QTabBar::tab:selected {
    background: #fdfdfd;
    color: rgba(0,0,0,0.85);
}
QTabBar::tab:hover:!selected {
    background: #d9d9d9;
}

/* ── 面板头与内部边框 (Dock 风格) ──
   DockHeader = surface_high 标题带; DockBody = 近白内容面板 (surface_lowest) */
QFrame#DockHeader {
    background-color: #d4d4d4;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QWidget#DockBody {
    background-color: #fdfdfd;
    border: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
QLabel#DockTitle {
    background-color: transparent;
    color: rgba(0,0,0,0.85);
    font-weight: bold;
}

/* ── 图形视图 ── */
QGraphicsView {
    border: 1px solid #b7b7b7;
    background-color: #f5f5f5;
}

/* ── 滚动区域 ── */
QScrollArea {
    background-color: #fdfdfd;
    border: none;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    background-color: #ffffff;
    border: 1px solid #b7b7b7;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background-color: #bebebe;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #2e80ff;
}

/* ── 状态栏 ── */
QStatusBar {
    background-color: #e6e6e6;
    color: rgba(0,0,0,0.55);
    border-top: 1px solid #b7b7b7;
    padding: 1px 6px;
}

/* ── 标签 ── */
QLabel {
    color: rgba(0,0,0,0.75);
    background-color: transparent;
}

/* ── 状态栏子标签 ── */
QLabel#StatusLabel {
    background-color: transparent;
    color: rgba(0,0,0,0.8);
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusSep {
    background-color: transparent;
    color: rgba(0,0,0,0.45);
    font-size: 12px;
    padding: 0 2px;
}
QLabel#StatusInfo {
    background-color: transparent;
    color: rgba(0,0,0,0.6);
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusPixel {
    background-color: transparent;
    color: rgba(0,0,0,0.45);
    font-size: 11px;
    padding: 0 4px;
    font-family: "Consolas", "Courier New", monospace;
}

/* ── 提示标签 ── */
QLabel#hintLabel {
    color: rgba(0,0,0,0.45);
    font-size: 11px;
}

/* ── Inspector 标题 (kon/wardata/warpc) ── */
QLabel[class="InspectorTitle"] {
    font-weight: bold;
    color: rgba(0,0,0,0.85);
    border-bottom: 1px solid #b7b7b7;
    padding-bottom: 2px;
    margin-top: 8px;
}
QLabel[class="PropLabel"] {
    color: rgba(0,0,0,0.7);
}

/* ── 预览区面板 (kon/wardata/warpc) ── */
QFrame#PreviewFrame {
    background-color: transparent;
    border: none;
    border-top: 2px solid #7ea6e0;
    border-bottom: 1px solid #b7b7b7;
    border-radius: 0px;
    margin-top: 4px;
    margin-bottom: 8px;
}
QLabel[class="PreviewName"] {
    color: rgba(0,0,0,0.85);
    font-size: 18px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI';
}
QLabel[class="PreviewMeta"] {
    color: rgba(0,0,0,0.55);
    font-size: 11px;
    border-bottom: 1px solid #cfcfcf;
    padding-bottom: 8px;
    margin-bottom: 4px;
}
QLabel[class="PreviewDesc"] {
    color: #4b9d53;
    font-size: 13px;
    padding-top: 4px;
}
QLabel[class="PreviewSubMeta"] {
    color: #cc3838;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
}

/* ── FakeInputBox 内凹输入框 (kon/wardata/warpc) ── */
QFrame#FakeInputBox {
    background-color: #f5f5f5;
    border: 1px solid #c3c3c3;
    border-radius: 4px;
}
QFrame#FakeInputBox:hover, QFrame#FakeInputBox:focus-within {
    background-color: #ffffff;
    border: 1px solid #2e80ff;
}
QFrame#FakeInputBox > QLineEdit {
    background: transparent;
    border: none;
    padding: 4px 8px;
    color: rgba(0,0,0,0.75);
    font-family: 'Consolas', 'Segoe UI';
    selection-background-color: #2e80ff;
    selection-color: #ffffff;
}
QFrame#FakeInputBox > QPushButton {
    background: transparent;
    border: none;
    border-left: 1px solid #cfcfcf;
    border-right: 1px solid #cfcfcf;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px;
    color: rgba(0,0,0,0.6);
}
QFrame#FakeInputBox > QPushButton:hover {
    background-color: #d9d9d9;
    color: rgba(0,0,0,0.85);
}
QFrame#FakeInputBox > QPushButton:first-child:hover {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}
QFrame#FakeInputBox > QComboBox {
    border: none;
    background: transparent;
    padding: 4px 8px;
    color: rgba(0,0,0,0.75);
}
QFrame#FakeInputBox > QComboBox::drop-down {
    border: none;
}
QFrame[class="FakeInputSep"] {
    background-color: #cfcfcf;
    border: none;
}

/* ── 额外预览文本 ── */
QLabel[class="ExtraPreviewText"] {
    padding: 4px 8px;
    color: #4b9d53;
    font-size: 11px;
}

/* ── 拆分字段内部标签 ── */
QLabel[class="SplitFieldLabel"] {
    color: rgba(0,0,0,0.55);
    font-size: 11px;
    padding: 0 2px;
}

/* ── 状态掩码标签颜色 (kon) ── */
QLabel[class="StatusInflict"] {
    color: #cc3838;
    font-size: 11px;
}
QLabel[class="StatusRemove"] {
    color: #3366cc;
    font-size: 11px;
}

/* ── 弹窗高亮主按钮 ── */
QPushButton#PrimaryButton {
    background-color: #2e80ff;
    color: #ffffff;
    border: 1px solid #1f66d1;
    font-weight: bold;
}
QPushButton#PrimaryButton:hover {
    background-color: #4a92ff;
}
QPushButton#PrimaryButton:pressed {
    background-color: #1f66d1;
}

/* ── 工具栏 (tks_launcher_gui) ── 与 chrome 同色 (base) */
QToolBar {
    background-color: #e6e6e6;
    border-bottom: 1px solid #b7b7b7;
    padding: 4px;
    spacing: 6px;
}

/* ── 控制台日志文本区 (tks_launcher_gui) ── */
/* 注意: 文字颜色由 log_console.py 通过 HTML 内联样式控制, 此处不设置 color */
QTextEdit#LogConsole {
    background-color: #ffffff;
    border: 1px solid #b7b7b7;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #2e80ff;
    selection-color: #ffffff;
}

/* ── QCheckBox 禁用状态 ── */
QCheckBox::indicator:disabled {
    background-color: #ececec;
    border-color: #d5d5d5;
}
QCheckBox::indicator:checked:disabled {
    background-color: rgba(46,128,255,0.5);
    border-color: rgba(46,128,255,0.5);
    image: url(svg/checkmark.svg);
}
/* 必选补丁复选框：禁用态文字保持正常颜色 */
QCheckBox#requiredPatch:disabled {
    color: rgba(0,0,0,0.75);
}

/* ── 滚动条悬停 (tks_launcher_gui) ── */
QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}
QScrollBar::handle:horizontal:hover {
    background-color: #b3b3b3;
}

/* ── 状态栏标签 (tks_launcher_gui) ── */
QLabel#statusLabel {
    color: rgba(0,0,0,0.75);
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelOk {
    color: #4b9d53;
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelError {
    color: #cc3838;
    font-weight: bold;
    padding: 4px 8px;
}

/* ── DockHeader 内紧凑工具按钮 (tks_launcher_gui) ── */
QToolButton#dockToolButton {
    background-color: transparent;
    color: rgba(0,0,0,0.75);
    border: none;
    border-radius: 3px;
    padding: 0px 6px;
    max-height: 20px;
}
QToolButton#dockToolButton:hover {
    background-color: #cacaca;
}
QToolButton#dockToolButton:pressed {
    background-color: #2e80ff;
    color: #fff;
}
QToolButton#dockToolButton:checked {
    background-color: #2e80ff;
    color: #ffffff;
}
QToolButton#dockToolButton:checked:hover {
    background-color: #4a92ff;
    color: #ffffff;
}

/* ── 启动按钮高亮 (tks_launcher_gui) ── */
QPushButton#btnStart {
    background-color: #3a8c52;
    color: #ffffff;
    border: 1px solid #2e7041;
    font-weight: bold;
}
QPushButton#btnStart:hover {
    background-color: #45a362;
}
QPushButton#btnStart:pressed {
    background-color: #2e7041;
    color: #ffffff;
}
QPushButton#btnStart:disabled {
    background-color: #d2d2d2;
    color: rgba(0,0,0,0.5);
    border-color: #b7b7b7;
}

/* ── 记录标题标签 (item/skill/mat/warpc 编辑器) ── */
QLabel[class="RecordHeader"] {
    font-size: 14px;
    font-weight: bold;
}

/* ── 状态提示标签 (mat_editor) ── */
QLabel[class="StatusHint"] {
    color: rgba(0,0,0,0.5);
    font-size: 11px;
}

/* ── 紧凑按钮 (mat_editor 工具栏) ── */
QPushButton[class="CompactBtn"] {
    padding-left: 4px;
    padding-right: 4px;
}

/* ── 打包/操作主按钮 (launcher dialogs) ── */
QPushButton#btnPack {
    font-weight: bold;
    padding: 6px 20px;
}

/* ── 图标选择器按钮 (item/warpc 编辑器) ── */
QPushButton[selected="true"] {
    background-color: #cfdfff;
    border: 2px solid #2e80ff;
}
QPushButton[selected="false"] {
    background-color: transparent;
    border: 1px solid transparent;
}

/* ── 活动槽位按钮 (save_editor) ── */
QPushButton[active="true"] {
    font-weight: bold;
    color: #2e80ff;
}
QPushButton[active="false"] {
    font-weight: normal;
    color: rgba(0,0,0,0.75);
}

/* ── Chip 小标签 (item_editor) ── */
QLabel[class="ChipLabel"] {
    font-size: 10px;
}

/* ── 等宽文本区 (字段来源弹窗) ── */
QTextEdit[class="MonoText"] {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 9pt;
}

/* ── 紧凑树控件 (mat_editor 场景/实体列表) ── */
QTreeWidget[class="CompactTree"] {
    font-size: 12px;
}
QTreeWidget[class="CompactTree"]::item {
    padding: 2px 4px;
    min-height: 22px;
}
QTreeWidget[class="CompactTree"] QHeaderView::section {
    padding: 4px 6px;
    font-weight: bold;
}

/* ── 成长率表格 (warpc_editor) ── */
QTableWidget[class="GrowthTable"]::item {
    background-color: #f6f6f6;
}
QTableWidget[class="GrowthTable"]::item:alternate {
    background-color: #efefef;
}
QTableWidget[class="GrowthTable"]::item:selected {
    background-color: #2e80ff;
    color: #ffffff;
}

/* ── 表格编辑模式 (warpc_editor) ── */
QTableView[class="WarpcGrid"] {
    alternate-background-color: #dedede;
    gridline-color: #d5d5d5;
}
QTableView[class="WarpcGrid"]::item:selected {
    background-color: #2e80ff;
    color: #ffffff;
}
QTableView[class="WarpcGrid"] QTableCornerButton::section {
    background-color: #d5d5d5;
    border: none;
}

/* ── 类型字段标签 (mat_editor 实体参数) ── */
QLabel[class="TypeFieldLabel"] {
    color: #d47d03;
}

/* ── 颜色色块 (mat/grp/wardata 色块通用) ── */
QFrame[class="ColorSwatch"], QLabel[class="ColorSwatch"] {
    background-color: #000000;
    border: 1px solid #adadad;
    border-radius: 3px;
}

/* ── 色块按钮 - 圆形 (tkt_editor 工具栏颜色快捷键) ── */
QPushButton[class="ColorSwatchRound"] {
    border: 1px solid #adadad;
    border-radius: 10px;
    padding: 0px;
}
QPushButton[class="ColorSwatchRound"]:hover {
    border: 2px solid #2e80ff;
}

/* ── 色块按钮 - 方形 (tkt_editor 调色板弹窗) ── */
QPushButton[class="ColorSwatchBtn"] {
    border: 1px solid #adadad;
    border-radius: 4px;
    padding: 0px;
}
QPushButton[class="ColorSwatchBtn"]:hover {
    border: 2px solid #2e80ff;
}

/* ── 路径状态标签 (loaded/missing/unloaded) ── */
QLabel[status="loaded"] {
    color: #4b9d53;
}
QLabel[status="missing"] {
    color: #cc3838;
}
QLabel[status="unloaded"] {
    color: rgba(0,0,0,0.45);
}

/* ── 方向指示复选框 (mat_editor) ── */
QCheckBox[class="DirCheckBox"] {
    font-size: 11px;
}

/* ── 提示文本标签 (输入框下方, 无左距) ── */
QLabel[class="FieldHint"] {
    padding-left: 0px;
    font-size: 11px;
    color: #4b9d53;
}

/* ── 脏标记标签 (tkt_editor) ── */
QLabel[class="DirtyIndicator"] {
    color: #cc3838;
    font-weight: bold;
}

/* ── 未知字段标签 (mat_editor “全部”页 d-index) ── */
QLabel[class="UnknownFieldLabel"] {
    color: rgba(0,0,0,0.45);
}

/* ── 探针标签 (act_editor 层/音效状态) ── */
QLabel[probe="ok"] {
    color: #4b9d53;
}
QLabel[probe="warn"] {
    color: #d47d03;
}
QLabel[probe="error"] {
    color: #cc3838;
}
QLabel[probe="empty"] {
    color: rgba(0,0,0,0.5);
}

/* ── 信息标题标签 (mat_editor 脚本预览) ── */
QLabel[class="InfoTitle"] {
    font-size: 13px;
    font-weight: bold;
}

/* ── 缩放按钮 (tkt/spritesheet 编辑器) ── */
QPushButton[class="ZoomBtn"] {
    padding: 0px;
    font-size: 12px;
}

/* ── 缩放比例标签 ── */
QLabel[class="ZoomLabel"] {
    font-size: 11px;
    background-color: transparent;
}

/* ── 透明背景容器 (scroll content) ── */
QWidget#TransparentBg {
    background: transparent;
}

/* ── 主标题标签 (tkt_editor 蓝色强调) ── */
QLabel[class="PrimaryTitle"] {
    font-weight: bold;
    color: #2e80ff;
}

/* ── 副标题标签 (tkt_editor 绿色强调) ── */
QLabel[class="SecondaryTitle"] {
    font-weight: bold;
    color: #4b9d53;
    padding-top: 10px;
}

/* ── 确认操作按钮 (tkt_editor) ── */
QPushButton[class="ConfirmBtn"] {
    font-weight: bold;
    padding: 8px;
    margin-top: 10px;
}

/* ── 分隔线框架 (QFrame separator) ── */
QFrame[class="SepLine"] {
    color: rgba(0,0,0,0.35);
}

/* ── 游戏预览区 (tkt_editor 模拟游戏文本渲染背景) ── */
QScrollArea#GamePreview, QTextEdit#GamePreview {
    background-color: #313c52;
    border: none;
}
QTextEdit#GamePreview {
    color: #ffffff;
}

/* ── configs_editor ── */

QFrame#Toolbar {
    max-height: 36px;
}

/* 召唤编辑对话框 — 目标选择器显示区 */
QWidget[class="TargetDisplay"] {
    border: 1px solid #b7b7b7;
    border-radius: 3px;
    background-color: #f5f5f5;
}
QLabel[class="TargetIcon"], QLabel[class="TargetName"] {
    border: none;
    background: transparent;
    color: rgba(0,0,0,0.75);
}
QLabel[class="TargetName"] {
    padding: 2px 0px;
}

/* 召唤表面板 — TKS目录未加载提示条 */
QFrame#SummonHintBar {
    background-color: rgba(255, 193, 7, 0.18);
    border-radius: 4px;
}
QLabel#SummonHintLabel {
    color: #d47d03;
    background: transparent;
}

/* 掉落概率面板 — 常规槽标签 */
QLabel#RegularPctLabel {
    font-weight: bold;
    color: #4b9d53;
}

/* 状态栏标签 — configs_editor */
QLabel#ConfigDirLabel[status="loaded"],
QLabel#StatusWarpcLabel[status="loaded"],
QLabel#StatusTktLabel[status="loaded"],
QLabel#StatusFaLabel[status="loaded"] {
    color: #4b9d53;
    font-weight: bold;
}
QLabel#ConfigDirLabel[status="missing"],
QLabel#StatusWarpcLabel[status="missing"],
QLabel#StatusTktLabel[status="missing"],
QLabel#StatusFaLabel[status="missing"] {
    color: #cc3838;
}
QLabel#ConfigDirLabel[status="unloaded"],
QLabel#StatusWarpcLabel[status="unloaded"],
QLabel#StatusTktLabel[status="unloaded"],
QLabel#StatusFaLabel[status="unloaded"] {
    color: rgba(0,0,0,0.45);
}
QLabel#StatusSkillLabel[status="loaded"] {
    color: #4b9d53;
    font-weight: bold;
}
QLabel#StatusSkillLabel[status="missing"] {
    color: #cc3838;
}
QLabel#StatusSkillLabel[status="unloaded"] {
    color: rgba(0,0,0,0.45);
}

/* WarPC 选择器 — 已选提示栏 */
QLabel#WarpcSelectedLabel {
    padding: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 0, 0.12);
}

/* ── 字形单元格 (font_editor) ── */
QLabel[class="GlyphCell"] {
    background-color: #f5f5f5;
    border: 1px solid #b7b7b7;
}

/* ── 状态 chips (tks_book) ── */
QWidget[class="Chip"] {
    background-color: #ececec;
    border-radius: 3px;
}

/* ── MOD 分类 Tag 标签 (mod_list 分类列, 按类型着色) ── */
QLabel[class="TagVisual"]   { color: #b0308a; background: rgba(176,48,138,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagAvatar"]   { color: #b05a1a; background: rgba(176,90,26,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMusic"]    { color: #2e7d32; background: rgba(46,125,50,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagStory"]    { color: #00796b; background: rgba(0,121,107,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagGameplay"] { color: #1565c0; background: rgba(21,101,192,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagSave"]     { color: #8d6e00; background: rgba(141,110,0,0.12); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagExe"]      { color: #c62828; background: rgba(198,40,40,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagConfig"]   { color: #455a64; background: rgba(69,90,100,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMixed"]    { color: #6a3ab2; background: rgba(106,58,178,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagOther"]    { color: #606878; background: rgba(96,104,120,0.12); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagFont"]     { color: #5d4037; background: rgba(93,64,55,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagInterface"]{ color: #3949ab; background: rgba(57,73,171,0.10); border-radius: 3px; padding: 1px 6px; }
QLabel[class="TagMap"]      { color: #558b2f; background: rgba(85,139,47,0.10); border-radius: 3px; padding: 1px 6px; }

/* ── 详情区 ── */
QTextBrowser#detailBox {
    background-color: transparent;
    border: none;
    color: rgba(0,0,0,0.75);
}

/* ── 对话框 (Window = surface_lowest 近白) ── */
QDialog {
    background-color: #fdfdfd;
}

/* ── 预览图占位框 (mod 导出/打包/合并/元数据编辑弹窗) ── */
QLabel#previewThumb {
    border: 2px dashed #adadad;
    border-radius: 6px;
    background-color: #f5f5f5;
    color: rgba(0,0,0,0.45);
}
QLabel#avatarPreview {
    border: 1px solid #c3c3c3;
    background-color: #f5f5f5;
}

/* ── 播放状态标签 (custom_music_dialog) ── */
QLabel#nowPlaying {
    color: rgba(0,0,0,0.45);
}
QLabel#nowPlaying[state="playing"] {
    color: #2e80ff;
}

/* ── 表头全选复选框 (launcher 列表) ── */
QCheckBox#headerCheck {
    background: transparent;
}

/* ── 学习模式提示 / 技能溢出警告 (warpc_editor) ── */
QLabel#learnModeHint {
    color: #2e80ff;
    font-size: 11px;
    padding: 2px 0 4px 0;
}
QLabel#overflowBanner {
    color: #ffffff;
    background-color: #cc3838;
    font-weight: bold;
    padding: 6px;
    border-radius: 4px;
}

/* ── 定位闪烁高亮 (warpc_editor 字段定位) ── */
QLabel[class="FlashHint"] {
    background-color: #e8a040;
    color: #1a1a1a;
    border-radius: 3px;
    padding: 1px 3px;
}

/* ── tks_book 语义值标签 (Godot Modern 语义色) ── */
QLabel[class="BookInfo"], QLabel[class="BookOk"], QLabel[class="BookBad"],
QLabel[class="BookSpecial"], QLabel[class="BookGold"], QLabel[class="BookMeta"],
QLabel[class="BookMuted"] {
    padding: 0px;
}
QLabel[class="BookInfo"]    { color: #2e80ff; }
QLabel[class="BookOk"]      { color: #4b9d53; }
QLabel[class="BookBad"]     { color: #cc3838; }
QLabel[class="BookSpecial"] { color: #7b4fa0; }
QLabel[class="BookGold"]    { color: #a07820; }
QLabel[class="BookMeta"]    { color: #143861; }
QLabel[class="BookMuted"]   { color: rgba(0,0,0,0.45); }
