/* Godot Editor 风格浅色主题 — 全局共享主题 (所有编辑器统一使用) */
/* 色板: 底色 #e0e4e8 / 边框 #b0b5bd / 强调 #478cbf */

QWidget {
    background-color: #e0e4e8;
    color: #222222;
    font-family: 'Segoe UI', 'Microsoft YaHei';
}

/* ── 表格 ── */
QTableWidget, QTreeWidget {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b5bd;
    selection-background-color: #478cbf;
    selection-color: #fff;
}
QHeaderView::section {
    background-color: #d1d6dc;
    border: none;
    border-bottom: 1px solid #b0b5bd;
    padding: 4px;
    color: #222;
}

/* ── 文本输入 ── */
QPlainTextEdit, QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    padding: 4px;
    border-radius: 2px;
    selection-background-color: #478cbf;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #478cbf;
}
QLineEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px dashed #d1d5db;
}

/* ── 按钮 ── */
QPushButton {
    background-color: #cdd3d9;
    border: 1px solid #a6abb2;
    border-radius: 4px;
    padding: 5px 12px;
    color: #111;
}
QPushButton:hover {
    background-color: #b8c0c7;
}
QPushButton:pressed {
    background-color: #8da4b8;
}
QPushButton:disabled {
    background-color: #d5d9dd;
    color: #999;
}

/* ── 下拉框 ── */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    padding: 4px;
    color: #222;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #b0b5bd;
    selection-background-color: #478cbf;
    selection-color: #ffffff;
    outline: none;
}

/* ── 数值输入 ── */
QSpinBox {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #b0b5bd;
    border-radius: 3px;
    padding: 2px 22px 2px 6px;
    min-width: 60px;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-bottom: 1px solid #b0b5bd;
    border-top-right-radius: 3px;
}
QSpinBox::up-arrow {
    image: url(svg/up-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-top: 1px solid #b0b5bd;
    border-bottom-right-radius: 3px;
}
QSpinBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #b8c0c7;
}
QSpinBox:focus {
    border-color: #478cbf;
}

/* ── 列表控件 ── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    outline: none;
}
QListWidget::item {
    border: none;
    border-radius: 0;
    padding: 2px 4px;
}
QListWidget::item:selected {
    background-color: #478cbf;
    color: white;
    border: none;
    border-radius: 0;
    outline: none;
}
QListWidget::indicator, QTableWidget::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 3px;
}
QListWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(svg/checkmark.svg);
}
QListWidget::indicator:hover, QTableWidget::indicator:hover {
    border-color: #8da4b8;
}

/* ── 分组框 ── */
QGroupBox {
    background-color: #e0e4e8;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #111;
}

/* ── 复选框 ── */
QCheckBox {
    color: #222;
    spacing: 6px;
    padding: 2px 0px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(svg/checkmark.svg);
}
QCheckBox::indicator:hover {
    border-color: #8da4b8;
}
QCheckBox:disabled {
    color: #999;
}

/* ── 单选按钮 ── */
QRadioButton {
    color: #222;
    spacing: 6px;
    padding: 2px 1px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 8px;
}
QRadioButton::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(svg/checkmark.svg);
}
QRadioButton::indicator:hover {
    border-color: #8da4b8;
}
QRadioButton:disabled {
    color: #999;
}

/* ── 分割线 ── */
QSplitter::handle {
    image: none;
    background-color: transparent;
}
QSplitter::handle:horizontal {
    border-left: 1px solid #b0b5bd;
    margin-left: 3px;
    margin-right: 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #b0b5bd;
    margin-top: 3px;
    margin-bottom: 3px;
}
QSplitter::handle:horizontal:hover {
    border-left: 1px solid #478cbf;
}
QSplitter::handle:vertical:hover {
    border-top: 1px solid #478cbf;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: #f2f5f7;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #b8c0c7;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #f2f5f7;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #b8c0c7;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── 菜单栏 ── */
QMenuBar {
    background-color: #e0e4e8;
    color: #222222;
    border-bottom: 1px solid #b0b5bd;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}
QMenuBar::item:selected {
    background-color: #b8c0c7;
    border-radius: 2px;
}
QMenuBar::item:pressed {
    background-color: #8da4b8;
    color: #111;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 24px;
    color: #222;
}
QMenu::item:selected {
    background-color: #478cbf;
    color: #ffffff;
    border-radius: 2px;
}
QMenu::separator {
    height: 1px;
    background-color: #b0b5bd;
    margin: 3px 6px;
}

/* ── Tab 页 ── */
QTabWidget::pane {
    border: 1px solid #b0b5bd;
    background-color: #e0e4e8;
    top: -1px;
}
QTabBar::tab {
    background: #e0e4e8;
    border: 1px solid #b0b5bd;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #222;
}
QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    font-weight: bold;
    color: #478cbf;
}
QTabBar::tab:hover:!selected {
    background: #b8c0c7;
}

/* ── 面板头与内部边框 (Dock 风格) ── */
QFrame#DockHeader {
    background-color: #b0b5bd;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QWidget#DockBody {
    background-color: #e0e4e8;
    border: 1px solid #b0b5bd;
    border-top: none;
}
QLabel#DockTitle {
    background-color: transparent;
    color: #111;
    font-weight: bold;
}

/* ── 图形视图 ── */
QGraphicsView {
    border: 1px solid #b0b5bd;
    background-color: #ffffff;
}

/* ── 滚动区域 ── */
QScrollArea {
    background-color: #e0e4e8;
    border: none;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background-color: #b8c0c7;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #478cbf;
}

/* ── 状态栏 ── */
QStatusBar {
    background-color: #e0e4e8;
    color: #666;
    border-top: 1px solid #b0b5bd;
    padding: 1px 6px;
}

/* ── 标签 ── */
QLabel {
    color: #222;
    background-color: transparent;
}

/* ── 状态栏子标签 ── */
QLabel#StatusLabel {
    background-color: transparent;
    color: #333333;
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusSep {
    background-color: transparent;
    color: #a0a8b4;
    font-size: 12px;
    padding: 0 2px;
}
QLabel#StatusInfo {
    background-color: transparent;
    color: #555555;
    font-size: 12px;
    padding: 0 4px;
}
QLabel#StatusPixel {
    background-color: transparent;
    color: #777777;
    font-size: 11px;
    padding: 0 4px;
    font-family: "Consolas", "Courier New", monospace;
}

/* ── 提示标签 ── */
QLabel#hintLabel {
    color: #888888;
    font-size: 11px;
}

/* ── Inspector 标题 (kon/wardata/warpc) ── */
QLabel[class="InspectorTitle"] {
    font-weight: bold;
    color: #111;
    border-bottom: 1px solid #b0b5bd;
    padding-bottom: 2px;
    margin-top: 8px;
}
QLabel[class="PropLabel"] {
    color: #444;
}

/* ── 预览区面板 (kon/wardata/warpc) ── */
QFrame#PreviewFrame {
    background-color: transparent;
    border: none;
    border-top: 2px solid #8caec7;
    border-bottom: 1px solid #b0b5bd;
    border-radius: 0px;
    margin-top: 4px;
    margin-bottom: 8px;
}
QLabel[class="PreviewName"] {
    color: #111111;
    font-size: 18px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI';
}
QLabel[class="PreviewMeta"] {
    color: #666666;
    font-size: 11px;
    border-bottom: 1px solid #d8dce3;
    padding-bottom: 8px;
    margin-bottom: 4px;
}
QLabel[class="PreviewDesc"] {
    color: #178a39;
    font-size: 13px;
    padding-top: 4px;
}
QLabel[class="PreviewSubMeta"] {
    color: #c93b16;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
}

/* ── FakeInputBox 内凹输入框 (kon/wardata/warpc) ── */
QFrame#FakeInputBox {
    background-color: #f7f9fa;
    border: 1px solid #c2c7ce;
    border-radius: 4px;
}
QFrame#FakeInputBox:hover, QFrame#FakeInputBox:focus-within {
    background-color: #ffffff;
    border: 1px solid #478cbf;
}
QFrame#FakeInputBox > QLineEdit {
    background: transparent;
    border: none;
    padding: 4px 8px;
    color: #222222;
    font-family: 'Consolas', 'Segoe UI';
    selection-background-color: #478cbf;
    selection-color: #ffffff;
}
QFrame#FakeInputBox > QPushButton {
    background: transparent;
    border: none;
    border-left: 1px solid #d8dce3;
    border-right: 1px solid #d8dce3;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px;
    color: #555555;
}
QFrame#FakeInputBox > QPushButton:hover {
    background-color: #e5e9f0;
    color: #111111;
}
QFrame#FakeInputBox > QPushButton:first-child:hover {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}
QFrame#FakeInputBox > QComboBox {
    border: none;
    background: transparent;
    padding: 4px 8px;
    color: #222222;
}
QFrame#FakeInputBox > QComboBox::drop-down {
    border: none;
}
QFrame[class="FakeInputSep"] {
    background-color: #d8dce3;
    border: none;
}

/* ── 额外预览文本 ── */
QLabel[class="ExtraPreviewText"] {
    padding: 4px 8px;
    color: #178a39;
    font-size: 11px;
}

/* ── 拆分字段内部标签 ── */
QLabel[class="SplitFieldLabel"] {
    color: #666;
    font-size: 11px;
    padding: 0 2px;
}

/* ── 状态掩码标签颜色 (kon) ── */
QLabel[class="StatusInflict"] {
    color: #cc3333;
    font-size: 11px;
}
QLabel[class="StatusRemove"] {
    color: #3366cc;
    font-size: 11px;
}

/* ── 弹窗高亮主按钮 ── */
QPushButton#PrimaryButton {
    background-color: #478cbf;
    color: #ffffff;
    border: 1px solid #366a91;
    font-weight: bold;
}
QPushButton#PrimaryButton:hover {
    background-color: #5aa1d5;
}
QPushButton#PrimaryButton:pressed {
    background-color: #366a91;
}

/* ── 工具栏 (tks_launcher_gui) ── */
QToolBar {
    background-color: #d1d6dc;
    border-bottom: 1px solid #b0b5bd;
    padding: 4px;
    spacing: 6px;
}

/* ── 控制台日志文本区 (tks_launcher_gui) ── */
/* 注意: 文字颜色由 log_console.py 通过 HTML 内联样式控制, 此处不设置 color */
QTextEdit#LogConsole {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #478cbf;
    selection-color: #ffffff;
}

/* ── QCheckBox 禁用状态 ── */
QCheckBox::indicator:disabled {
    background-color: #e8ecf0;
    border-color: #d1d6dc;
}
QCheckBox::indicator:checked:disabled {
    background-color: #8CB8D9;
    border-color: #8CB8D9;
    image: url(svg/checkmark.svg);
}
/* 必选补丁复选框：禁用态文字保持正常颜色 */
QCheckBox#requiredPatch:disabled {
    color: #222;
}

/* ── 滚动条悬停 (tks_launcher_gui) ── */
QScrollBar::handle:vertical:hover {
    background-color: #8da4b8;
}
QScrollBar::handle:horizontal:hover {
    background-color: #8da4b8;
}

/* ── 状态栏标签 (tks_launcher_gui) ── */
QLabel#statusLabel {
    color: #222222;
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelOk {
    color: #2E7D32;
    font-weight: bold;
    padding: 4px 8px;
}
QLabel#statusLabelError {
    color: #C62828;
    font-weight: bold;
    padding: 4px 8px;
}

/* ── DockHeader 内紧凑工具按钮 (tks_launcher_gui) ── */
QToolButton#dockToolButton {
    background-color: transparent;
    color: #222222;
    border: none;
    border-radius: 3px;
    padding: 0px 6px;
    max-height: 16px;
}
QToolButton#dockToolButton:hover {
    background-color: #cdd3d9;
}
QToolButton#dockToolButton:pressed {
    background-color: #478cbf;
    color: #fff;
}

/* ── 启动按钮高亮 (tks_launcher_gui) ── */
QPushButton#btnStart {
    background-color: #3a8c52;
    color: #ffffff;
    border: 1px solid #2e7041;
    font-weight: bold;
}
QPushButton#btnStart:hover {
    background-color: #45a362;
}
QPushButton#btnStart:pressed {
    background-color: #2e7041;
    color: #ffffff;
}
QPushButton#btnStart:disabled {
    background-color: #d5d9dd;
    color: #999;
    border-color: #b0b5bd;
}

/* ── 记录标题标签 (item/skill/mat/warpc 编辑器) ── */
QLabel[class="RecordHeader"] {
    font-size: 14px;
    font-weight: bold;
}

/* ── 状态提示标签 (mat_editor) ── */
QLabel[class="StatusHint"] {
    color: #777;
    font-size: 11px;
}

/* ── 紧凑按钮 (mat_editor 工具栏) ── */
QPushButton[class="CompactBtn"] {
    padding-left: 4px;
    padding-right: 4px;
}

/* ── 打包/操作主按钮 (launcher dialogs) ── */
QPushButton#btnPack {
    font-weight: bold;
    padding: 6px 20px;
}

/* ── 图标选择器按钮 (item/warpc 编辑器) ── */
QPushButton[selected="true"] {
    background-color: #d0e8ff;
    border: 2px solid #478cbf;
}
QPushButton[selected="false"] {
    background-color: transparent;
    border: 1px solid transparent;
}

/* ── 活动槽位按钮 (save_editor) ── */
QPushButton[active="true"] {
    font-weight: bold;
    color: #478cbf;
}
QPushButton[active="false"] {
    font-weight: normal;
    color: #222;
}

/* ── Chip 小标签 (item_editor) ── */
QLabel[class="ChipLabel"] {
    font-size: 10px;
}

/* ── 等宽文本区 (字段来源弹窗) ── */
QTextEdit[class="MonoText"] {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 9pt;
}

/* ── 紧凑树控件 (mat_editor 场景/实体列表) ── */
QTreeWidget[class="CompactTree"] {
    font-size: 12px;
}
QTreeWidget[class="CompactTree"]::item {
    padding: 2px 4px;
    min-height: 22px;
}
QTreeWidget[class="CompactTree"] QHeaderView::section {
    padding: 4px 6px;
    font-weight: bold;
}

/* ── 成长率表格 (warpc_editor) ── */
QTableWidget[class="GrowthTable"]::item {
    background-color: #ffffff;
}
QTableWidget[class="GrowthTable"]::item:alternate {
    background-color: #f5f5f5;
}
QTableWidget[class="GrowthTable"]::item:selected {
    background-color: #478cbf;
    color: #ffffff;
}

/* ── 类型字段标签 (mat_editor 实体参数) ── */
QLabel[class="TypeFieldLabel"] {
    color: #b85c00;
}

/* ── 颜色色块 (mat/grp/wardata 色块通用) ── */
QFrame[class="ColorSwatch"], QLabel[class="ColorSwatch"] {
    background-color: #000000;
    border: 1px solid #999;
    border-radius: 3px;
}

/* ── 色块按钮 - 圆形 (tkt_editor 工具栏颜色快捷键) ── */
QPushButton[class="ColorSwatchRound"] {
    border: 1px solid #999;
    border-radius: 10px;
    padding: 0px;
}
QPushButton[class="ColorSwatchRound"]:hover {
    border: 2px solid #478cbf;
}

/* ── 色块按钮 - 方形 (tkt_editor 调色板弹窗) ── */
QPushButton[class="ColorSwatchBtn"] {
    border: 1px solid #999;
    border-radius: 4px;
    padding: 0px;
}
QPushButton[class="ColorSwatchBtn"]:hover {
    border: 2px solid #478cbf;
}

/* ── 路径状态标签 (loaded/missing/unloaded) ── */
QLabel[status="loaded"] {
    color: #178a39;
}
QLabel[status="missing"] {
    color: #c93b16;
}
QLabel[status="unloaded"] {
    color: #888;
}

/* ── 方向指示复选框 (mat_editor) ── */
QCheckBox[class="DirCheckBox"] {
    font-size: 11px;
}

/* ── 提示文本标签 (输入框下方, 无左距) ── */
QLabel[class="FieldHint"] {
    padding-left: 0px;
    font-size: 11px;
    color: #178a39;
}

/* ── 脏标记标签 (tkt_editor) ── */
QLabel[class="DirtyIndicator"] {
    color: #c93b16;
    font-weight: bold;
}

/* ── 未知字段标签 (mat_editor “全部”页 d-index) ── */
QLabel[class="UnknownFieldLabel"] {
    color: #888;
}

/* ── 探针标签 (act_editor 层/音效状态) ── */
QLabel[probe="ok"] {
    color: #2E7D32;
}
QLabel[probe="warn"] {
    color: #B85C00;
}
QLabel[probe="error"] {
    color: #C62828;
}
QLabel[probe="empty"] {
    color: #999;
}

/* ── 信息标题标签 (mat_editor 脚本预览) ── */
QLabel[class="InfoTitle"] {
    font-size: 13px;
    font-weight: bold;
}

/* ── 缩放按钮 (tkt/spritesheet 编辑器) ── */
QPushButton[class="ZoomBtn"] {
    padding: 0px;
    font-size: 12px;
}

/* ── 缩放比例标签 ── */
QLabel[class="ZoomLabel"] {
    font-size: 11px;
    background-color: transparent;
}

/* ── 透明背景容器 (scroll content) ── */
QWidget#TransparentBg {
    background: transparent;
}

/* ── 主标题标签 (tkt_editor 蓝色强调) ── */
QLabel[class="PrimaryTitle"] {
    font-weight: bold;
    color: #478cbf;
}

/* ── 副标题标签 (tkt_editor 绿色强调) ── */
QLabel[class="SecondaryTitle"] {
    font-weight: bold;
    color: #2E7D32;
    padding-top: 10px;
}

/* ── 确认操作按钮 (tkt_editor) ── */
QPushButton[class="ConfirmBtn"] {
    font-weight: bold;
    padding: 8px;
    margin-top: 10px;
}

/* ── 分隔线框架 (QFrame separator) ── */
QFrame[class="SepLine"] {
    color: #aaa;
}

/* ── 游戏预览区 (tkt_editor 模拟游戏文本渲染背景) ── */
QScrollArea#GamePreview, QTextEdit#GamePreview {
    background-color: #313c52;
    border: none;
}
QTextEdit#GamePreview {
    color: #ffffff;
}

/* ── configs_editor ── */

QFrame#Toolbar {
    max-height: 36px;
}

/* 召唤编辑对话框 — 目标选择器显示区 */
QWidget[class="TargetDisplay"] {
    border: 1px solid #b0b5bd;
    border-radius: 3px;
    background-color: #ffffff;
}
QLabel[class="TargetIcon"], QLabel[class="TargetName"] {
    border: none;
    background: transparent;
    color: #222222;
}
QLabel[class="TargetName"] {
    padding: 2px 0px;
}

/* 召唤表面板 — TKS目录未加载提示条 */
QFrame#SummonHintBar {
    background-color: rgba(255, 193, 7, 0.18);
    border-radius: 4px;
}
QLabel#SummonHintLabel {
    color: #B8860B;
    background: transparent;
}

/* 掉落概率面板 — 常规槽标签 */
QLabel#RegularPctLabel {
    font-weight: bold;
    color: #178a39;
}

/* 状态栏标签 — configs_editor */
QLabel#ConfigDirLabel[status="loaded"],
QLabel#StatusWarpcLabel[status="loaded"],
QLabel#StatusTktLabel[status="loaded"],
QLabel#StatusFaLabel[status="loaded"] {
    color: #178a39;
    font-weight: bold;
}
QLabel#ConfigDirLabel[status="missing"],
QLabel#StatusWarpcLabel[status="missing"],
QLabel#StatusTktLabel[status="missing"],
QLabel#StatusFaLabel[status="missing"] {
    color: #c93b16;
}
QLabel#ConfigDirLabel[status="unloaded"],
QLabel#StatusWarpcLabel[status="unloaded"],
QLabel#StatusTktLabel[status="unloaded"],
QLabel#StatusFaLabel[status="unloaded"] {
    color: #888888;
}
QLabel#StatusSkillLabel[status="loaded"] {
    color: #178a39;
    font-weight: bold;
}
QLabel#StatusSkillLabel[status="missing"] {
    color: #c93b16;
}
QLabel#StatusSkillLabel[status="unloaded"] {
    color: #888888;
}

/* WarPC 选择器 — 已选提示栏 */
QLabel#WarpcSelectedLabel {
    padding: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 0, 0.12);
}
