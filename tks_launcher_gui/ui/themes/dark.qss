/* Godot Editor 风格深色主题 */
QMainWindow, QWidget {
    background-color: #202531;
    color: #D3D5D9;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QToolBar {
    background-color: #252A38;
    border-bottom: 1px solid #414859;
    padding: 4px;
    spacing: 6px;
}

QPushButton {
    background-color: #414859;
    color: #D3D5D9;
    border: 1px solid #525A6E;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #525A6E;
}
QPushButton:pressed {
    background-color: #313745;
}
QPushButton:disabled {
    background-color: #2D3340;
    color: #666;
}

QTextEdit {
    background-color: #171A21;
    color: #C8CCD4;
    border: 1px solid #414859;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #478cbf;
}

QScrollArea {
    background-color: #202531;
    border: 1px solid #414859;
    border-radius: 4px;
}
QScrollArea > QWidget > QWidget {
    background-color: #202531;
}

QScrollBar:vertical {
    background-color: #171A21;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #414859;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #525A6E;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QCheckBox {
    color: #D3D5D9;
    spacing: 8px;
    padding: 4px 0px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #171A21;
    border: 1px solid #414859;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(checkmark.svg);
}
QCheckBox::indicator:hover {
    border-color: #525A6E;
}
QCheckBox:disabled {
    color: #666;
}
QCheckBox::indicator:disabled {
    background-color: #2D3340;
    border-color: #313745;
}
QCheckBox::indicator:checked:disabled {
    background-color: #2D4A5E;
    border-color: #2D4A5E;
    image: url(checkmark.svg);
}

QSplitter::handle {
    background-color: #414859;
    width: 2px;
}

QStatusBar {
    background-color: #252A38;
    color: #8A8F9A;
    border-top: 1px solid #414859;
    padding: 2px 8px;
}

QLabel#statusLabel {
    color: #D3D5D9;
    font-weight: bold;
    padding: 4px 8px;
}
