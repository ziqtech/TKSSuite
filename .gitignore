# 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# C 扩展编译产物
*.so

# 打包/发行元数据
*.egg
*.egg-info/
.eggs/
eggs/
develop-eggs/
sdist/
wheels/
pip-wheel-metadata/
MANIFEST

# PyInstaller / Nuitka 构建中间产物
# 注意: 本仓库的 build/ 目录存放构建脚本且已被跟踪, 不可整体忽略,
# 仅忽略其下的产物子目录 (见下方项目专属规则)
*.manifest
*.spec
*.build/
*.dist/
*.onefile-build/
*.const

# 虚拟环境
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 测试 / 覆盖率
