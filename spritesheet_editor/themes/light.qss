/* Godot Editor 风格浅色主题 — Spritesheet Editor v2 */
/* 色板: 底色 #e0e4e8 / 边框 #b0b5bd / 强调 #478cbf */

QWidget {
    background-color: #e0e4e8;
    color: #222222;
    font-family: 'Segoe UI', 'Microsoft YaHei';
}

/* ── 表格 ── */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f2f5f7;
    border: 1px solid #b0b5bd;
    selection-background-color: #478cbf;
    selection-color: #fff;
}
QHeaderView::section {
    background-color: #d1d6dc;
    border: none;
    border-bottom: 1px solid #b0b5bd;
    padding: 4px;
    color: #222;
}

/* ── 文本输入 ── */
QPlainTextEdit, QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    padding: 4px;
    border-radius: 2px;
    selection-background-color: #478cbf;
}

/* ── 按钮 ── */
QPushButton {
    background-color: #cdd3d9;
    border: 1px solid #a6abb2;
    border-radius: 4px;
    padding: 5px 12px;
    color: #111;
}
QPushButton:hover {
    background-color: #b8c0c7;
}
QPushButton:pressed {
    background-color: #8da4b8;
}
QPushButton:disabled {
    background-color: #d5d9dd;
    color: #999;
}

/* ── 下拉框 ── */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    padding: 4px;
    color: #222;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #b0b5bd;
    selection-background-color: #478cbf;
    selection-color: #ffffff;
    outline: none;
}

/* ── 数值输入 ── */
QSpinBox {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #b0b5bd;
    border-radius: 3px;
    padding: 2px 22px 2px 6px;
    min-width: 60px;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-bottom: 1px solid #b0b5bd;
    border-top-right-radius: 3px;
}
QSpinBox::up-arrow {
    image: url(svg/up-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-top: 1px solid #b0b5bd;
    border-bottom-right-radius: 3px;
}
QSpinBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #b8c0c7;
}
QSpinBox:focus {
    border-color: #478cbf;
}

/* ── 列表控件 ── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
}
QListWidget::item:selected {
    background-color: #478cbf;
    color: white;
}

/* ── 分组框 ── */
QGroupBox {
    background-color: #e0e4e8;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #111;
}

/* ── 复选框 ── */
QCheckBox {
    color: #222;
    spacing: 6px;
    padding: 2px 0px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(svg/checkmark.svg);
}
QCheckBox::indicator:hover {
    border-color: #8da4b8;
}
QCheckBox:disabled {
    color: #999;
}

/* ── 单选按钮 ── */
QRadioButton {
    color: #222;
    spacing: 6px;
    padding: 2px 1px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 8px;
}
QRadioButton::indicator:checked {
    background-color: #478cbf;
    border-color: #478cbf;
    image: url(svg/checkmark.svg);
}
QRadioButton::indicator:hover {
    border-color: #8da4b8;
}
QRadioButton:disabled {
    color: #999;
}

/* ── 分割线 ── */
QSplitter::handle {
    image: none;
    background-color: transparent;
}
QSplitter::handle:horizontal {
    border-left: 1px solid #b0b5bd;
    margin-left: 3px;
    margin-right: 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #b0b5bd;
    margin-top: 3px;
    margin-bottom: 3px;
}
QSplitter::handle:horizontal:hover {
    border-left: 1px solid #478cbf;
}
QSplitter::handle:vertical:hover {
    border-top: 1px solid #478cbf;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: #f2f5f7;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #b8c0c7;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #f2f5f7;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #b8c0c7;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── 菜单栏 ── */
QMenuBar {
    background-color: #e0e4e8;
    color: #222222;
    border-bottom: 1px solid #b0b5bd;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}
QMenuBar::item:selected {
    background-color: #b8c0c7;
    border-radius: 2px;
}
QMenuBar::item:pressed {
    background-color: #8da4b8;
    color: #111;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 24px;
    color: #222;
}
QMenu::item:selected {
    background-color: #478cbf;
    color: #ffffff;
    border-radius: 2px;
}
QMenu::separator {
    height: 1px;
    background-color: #b0b5bd;
    margin: 3px 6px;
}

/* ── 面板头与内部边框 (Dock 风格) ── */
QFrame#DockHeader {
    background-color: #b0b5bd;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QWidget#DockBody {
    background-color: #e0e4e8;
    border: 1px solid #b0b5bd;
    border-top: none;
}
QLabel#DockTitle {
    background-color: transparent;
    color: #111;
    font-weight: bold;
}

/* ── 图形视图 ── */
QGraphicsView {
    border: 1px solid #b0b5bd;
    background-color: #ffffff;
}

/* ── 滚动区域 ── */
QScrollArea {
    background-color: #e0e4e8;
    border: none;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background-color: #b8c0c7;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #478cbf;
}

/* ── 状态栏 ── */
QStatusBar {
    background-color: #e0e4e8;
    color: #666;
    border-top: 1px solid #b0b5bd;
    padding: 1px 6px;
}

/* ── 标签 ── */
QLabel {
    color: #222;
    background-color: transparent;
}
