/* Godot Editor 风格浅色主题 — Spritesheet Editor */
QMainWindow, QWidget {
    background-color: #F0F0F0;
    color: #333333;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ── 工具栏 ── */
QToolBar {
    background-color: #E8E8E8;
    border-bottom: 1px solid #CCCCCC;
    padding: 4px;
    spacing: 6px;
}

/* ── 按钮 ── */
QPushButton {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #F5F5F5;
    border-color: #999999;
}
QPushButton:pressed {
    background-color: #E0E0E0;
}
QPushButton:disabled {
    background-color: #F0F0F0;
    color: #999;
}

/* ── 文本框 ── */
QTextEdit {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #4A9BD9;
    selection-color: #FFFFFF;
}

/* ── 输入框 ── */
QLineEdit {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #4A9BD9;
}

/* ── 数值输入 ── */
QSpinBox {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 2px 22px 2px 6px;
    min-width: 60px;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #E8E8E8;
    width: 18px;
    border-left: 1px solid #CCCCCC;
    border-bottom: 1px solid #CCCCCC;
    border-top-right-radius: 2px;
}
QSpinBox::up-arrow {
    image: url(svg/up-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #E8E8E8;
    width: 18px;
    border-left: 1px solid #CCCCCC;
    border-top: 1px solid #CCCCCC;
    border-bottom-right-radius: 2px;
}
QSpinBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #D0D0D0;
}
QSpinBox::up-arrow:on, QSpinBox::down-arrow:on {
    top: 1px;
}
QSpinBox:focus {
    border-color: #4A9BD9;
}

/* ── 下拉框 ── */
QComboBox {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 3px 24px 3px 8px;
    min-width: 100px;
}
QComboBox:hover {
    border-color: #999999;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    background-color: #E8E8E8;
    width: 22px;
    border-left: 1px solid #CCCCCC;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}
QComboBox::down-arrow {
    image: url(svg/down-arrow-light.svg);
    width: 12px;
    height: 12px;
}
QComboBox::drop-down:hover {
    background-color: #D0D0D0;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    selection-background-color: #4A9BD9;
    selection-color: #FFFFFF;
    outline: none;
}

/* ── 分组框 ── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 5px;
    margin-top: 10px;
    padding: 12px 8px 8px 8px;
    font-weight: bold;
    color: #444444;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 6px;
    background-color: #E0E0E0;
    border-radius: 3px;
    color: #333333;
}

/* ── 复选框 ── */
QCheckBox {
    color: #333333;
    spacing: 6px;
    padding: 2px 0px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #4A9BD9;
    border-color: #4A9BD9;
    image: url(svg/checkmark.svg);
}
QCheckBox::indicator:hover {
    border-color: #999999;
}
QCheckBox:disabled {
    color: #999;
}
QCheckBox::indicator:disabled {
    background-color: #E8E8E8;
    border-color: #D0D0D0;
}

/* ── 单选按钮 ── */
QRadioButton {
    color: #333333;
    spacing: 6px;
    padding: 2px 1px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
}
QRadioButton::indicator:checked {
    background-color: #4A9BD9;
    border-color: #4A9BD9;
}
QRadioButton::indicator:hover {
    border-color: #999999;
}
QRadioButton:disabled {
    color: #999;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background-color: #E8E8E8;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #CCCCCC;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #AAAAAA;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #E8E8E8;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #CCCCCC;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #AAAAAA;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── 列表控件 ── */
QListWidget {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 3px;
    outline: none;
}
QListWidget::item {
    background-color: #F8F8F8;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
    margin: 1px 0px;
}
QListWidget::item:hover {
    background-color: #E8E8E8;
    border-color: #CCCCCC;
}
QListWidget::item:selected {
    background-color: #4A9BD9;
    border-color: #4A9BD9;
    color: #FFFFFF;
}

/* ── 图形视图 ── */
QGraphicsView {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

/* ── 滚动区域 ── */
QScrollArea {
    background-color: #F0F0F0;
    border: none;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    background-color: #E8E8E8;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    height: 6px;
}
QSlider::handle:horizontal {
    background-color: #4A9BD9;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #6AB0E0;
}
QSlider::sub-page:horizontal {
    background-color: #8CB8D9;
    border-radius: 3px;
}

/* ── 分割条 ── */
QSplitter::handle {
    background-color: #CCCCCC;
    width: 2px;
}

/* ── 菜单栏 ── */
QMenuBar {
    background-color: #E8E8E8;
    color: #333333;
    border-bottom: 1px solid #CCCCCC;
    padding: 1px;
}
QMenuBar::item {
    padding: 3px 8px;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #D0D0D0;
}

QMenu {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 3px;
}
QMenu::item {
    padding: 5px 28px 5px 14px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #4A9BD9;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background-color: #CCCCCC;
    margin: 3px 6px;
}

/* ── 状态栏 ── */
QStatusBar {
    background-color: #E8E8E8;
    color: #666666;
    border-top: 1px solid #CCCCCC;
    padding: 1px 6px;
}

/* ── 标签 ── */
QLabel {
    color: #333333;
    background-color: transparent;
}

/* ── 提示标签 ── */
QLabel#hintLabel {
    color: #888888;
    font-size: 11px;
}
