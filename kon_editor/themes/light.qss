/* Godot Editor 风格浅色主题 — TKKon Editor (基于 shop_editor + skill_editor 配色体系) */
QMainWindow, QWidget, QDialog {
    background-color: #e0e4e8;
    color: #222222;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ── 表格视图 ── */
QTableWidget { background-color: #ffffff; alternate-background-color: #f2f5f7; border: 1px solid #b0b5bd; selection-background-color: #478cbf; selection-color: #ffffff; outline: none; }
QTableWidget::item:hover { background-color: transparent; }
QHeaderView::section { background-color: #d1d6dc; border: none; border-bottom: 1px solid #b0b5bd; padding: 4px; color: #222; }

/* ── 按钮 ── */
QPushButton {
    background-color: #cdd3d9;
    color: #111111;
    border: 1px solid #a6abb2;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover { background-color: #b8c0c7; }
QPushButton:pressed { background-color: #8da4b8; }

/* ── 输入框 ── */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b5bd;
    border-radius: 2px;
    padding: 4px;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #478cbf;
}
QLineEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px dashed #d1d5db;
}

/* ── 下拉框 ── */
QComboBox {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    padding: 4px 8px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    selection-background-color: #478cbf;
}

/* ── 数字输入框 ── */
QSpinBox {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b5bd;
    border-radius: 2px;
    padding: 2px 22px 2px 6px;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-bottom: 1px solid #b0b5bd;
    border-top-right-radius: 2px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #cdd3d9;
    width: 18px;
    border-left: 1px solid #b0b5bd;
    border-bottom-right-radius: 2px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #b8c0c7;
}
QSpinBox::up-arrow { image: url(svg/up-arrow-light.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow { image: url(svg/down-arrow-light.svg); width: 8px; height: 8px; }
QSpinBox:focus { border-color: #478cbf; }

/* ── 分割线 ── */
QSplitter::handle { image: none; background-color: transparent; }
QSplitter::handle:horizontal {
    border-left: 1px solid #b0b5bd;
    margin-left: 3px;
    margin-right: 3px;
}
QSplitter::handle:vertical {
    border-top: 1px solid #b0b5bd;
    margin-top: 3px;
    margin-bottom: 3px;
}
QSplitter::handle:horizontal:hover { border-left: 1px solid #478cbf; }
QSplitter::handle:vertical:hover { border-top: 1px solid #478cbf; }

/* ── 滚动条 ── */
QScrollBar:vertical { background: #f2f5f7; width: 12px; }
QScrollBar::handle:vertical {
    background: #b8c0c7;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal { background: #f2f5f7; height: 12px; }
QScrollBar::handle:horizontal {
    background: #b8c0c7;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* ── 菜单 ── */
QMenuBar { background-color: #e0e4e8; color: #222222; border-bottom: 1px solid #b0b5bd; }
QMenuBar::item { background: transparent; padding: 5px 10px; }
QMenuBar::item:selected { background-color: #b8c0c7; border-radius: 2px; }
QMenuBar::item:pressed { background-color: #8da4b8; color: #111111; }
QMenu { background-color: #ffffff; border: 1px solid #b0b5bd; padding: 4px; }
QMenu::item { padding: 6px 24px; color: #222222; }
QMenu::item:selected { background-color: #478cbf; color: #ffffff; border-radius: 2px; }
QMenu::separator { height: 1px; background: #b0b5bd; margin: 4px 0px; }

/* ── QRadioButton / QCheckBox ── */
QRadioButton { color: #222222; spacing: 6px; }
QRadioButton::indicator {
    width: 16px; height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 8px;
}
QRadioButton::indicator:checked { background-color: #478cbf; border-color: #478cbf; }
QRadioButton::indicator:hover { border-color: #478cbf; }

QCheckBox { color: #222222; spacing: 6px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    background-color: #ffffff;
    border: 1px solid #b0b5bd;
    border-radius: 2px;
}
QCheckBox::indicator:checked { background-color: #478cbf; border-color: #478cbf; image: url(svg/checkmark.svg); }
QCheckBox::indicator:hover { border-color: #478cbf; }

/* ── Dock 面板 (tkt_editor_v5 风格) ── */
QFrame#DockHeader { background-color: #b0b5bd; border-top-left-radius: 4px; border-top-right-radius: 4px; }
QWidget#DockBody { background-color: #e0e4e8; border: 1px solid #b0b5bd; border-top: none; }
QLabel#DockTitle { background-color: transparent; color: #111; font-weight: bold; }

/* ── Inspector 标题 ── */
QLabel[class="InspectorTitle"] {
    font-weight: bold;
    color: #111;
    border-bottom: 1px solid #b0b5bd;
    padding-bottom: 2px;
    margin-top: 8px;
}
QLabel[class="PropLabel"] { color: #444; }

/* ── 预览区面板 ── */
QFrame#PreviewFrame {
    background-color: transparent;
    border: none;
    border-top: 2px solid #8caec7;
    border-bottom: 1px solid #b0b5bd;
    border-radius: 0px;
    margin-top: 4px;
    margin-bottom: 8px;
}
QLabel[class="PreviewName"] {
    color: #111111;
    font-size: 18px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI';
}
QLabel[class="PreviewMeta"] {
    color: #666666;
    font-size: 11px;
    border-bottom: 1px solid #d8dce3;
    padding-bottom: 8px;
    margin-bottom: 4px;
}
QLabel[class="PreviewDesc"] {
    color: #178a39;
    font-size: 13px;
    padding-top: 4px;
}
QLabel[class="PreviewSubMeta"] {
    color: #c93b16;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
}

/* ── FakeInputBox 内凹输入框外壳 ── */
QFrame#FakeInputBox {
    background-color: #f7f9fa;
    border: 1px solid #c2c7ce;
    border-radius: 4px;
}
QFrame#FakeInputBox:hover, QFrame#FakeInputBox:focus-within {
    background-color: #ffffff;
    border: 1px solid #478cbf;
}
QFrame#FakeInputBox > QLineEdit {
    background: transparent;
    border: none;
    padding: 4px 8px;
    color: #222222;
    font-family: 'Consolas', 'Segoe UI';
    selection-background-color: #478cbf;
    selection-color: #ffffff;
}
QFrame#FakeInputBox > QPushButton {
    background: transparent;
    border: none;
    border-left: 1px solid #d8dce3;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px;
    color: #555555;
}
QFrame#FakeInputBox > QPushButton:hover { background-color: #e5e9f0; color: #111111; }
QFrame#FakeInputBox > QPushButton:first-child:hover { border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
QFrame#FakeInputBox > QComboBox {
    border: none;
    background: transparent;
    padding: 4px 8px;
    color: #222222;
}
QFrame#FakeInputBox > QComboBox::drop-down { border: none; }

/* ── 额外预览文本 ── */
QLabel[class="ExtraPreviewText"] {
    padding: 4px 8px;
    color: #178a39;
    font-size: 11px;
}

/* ── 拆分字段内部标签 ── */
QLabel[class="SplitFieldLabel"] {
    color: #666;
    font-size: 11px;
    padding: 0 4px;
    min-width: 40px;
    max-width: 40px;
}

/* ── QGroupBox ── */
QGroupBox {
    border: 1px solid #b0b5bd;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #4b5563;
}

/* ── 状态栏 ── */
QStatusBar {
    background-color: #d1d6dc;
    color: #333333;
    border-top: 1px solid #b0b5bd;
}

/* ── 提示标签 ── */
QLabel#hintLabel {
    color: #888888;
    font-size: 11px;
}

/* ── 状态掩码标签颜色 ── */
QLabel[class="StatusInflict"] {
    color: #cc3333;
    font-size: 11px;
}
QLabel[class="StatusRemove"] {
    color: #3366cc;
    font-size: 11px;
}

QScrollArea { border: none; background-color: transparent; }
QScrollArea > QWidget > QWidget { background-color: transparent; }
